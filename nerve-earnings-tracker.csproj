<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>nerve_earnings_tracker</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>nerve_earnings_tracker.App</StartupObject>
    <ApplicationIcon>Resources\App.ico</ApplicationIcon>
    <Version Condition="'$(ReleaseVersion)' != ''">$(ReleaseVersion)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**;artifacts\**;bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Resources\App.ico" />
    <AssemblyMetadata Include="ReleaseVersion" Value="$(ReleaseVersion)" Condition="'$(ReleaseVersion)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <None Remove="Resources\Fonts\Inter-VariableFont_opsz,wght.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentIcons.Wpf" Version="2.1.339.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Fonts\Inter-VariableFont_opsz,wght.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\games.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Data\catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Data\Artwork\**\*.img">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="RejectPrivatePublishFiles" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_PrivatePublishFile Include="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(RelativePath)', '(?i)(^|[\\/])(backups?|exports?|personaldata|credentials)([\\/]|$)|\.(db|db3|sqlite|sqlite3)(-|$)|\.(bak|backup|pfx|p12|pem|key)$|(^|[\\/])\.env($|\.)')) Or ($([System.Text.RegularExpressions.Regex]::IsMatch('%(RelativePath)', '(?i)(^|[\\/])Data[\\/]')) And !$([System.Text.RegularExpressions.Regex]::IsMatch('%(RelativePath)', '(?i)(^|[\\/])Data[\\/](games\.json|catalog\.json|Artwork[\\/][a-f0-9]{64}\.img)$')))" />
    </ItemGroup>
    <Error Condition="'@(_PrivatePublishFile)' != ''" Text="Private data cannot be published: @(_PrivatePublishFile)" />
  </Target>

</Project>
