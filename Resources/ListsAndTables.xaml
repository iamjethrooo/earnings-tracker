<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:enums="clr-namespace:EarningsTracker.Enums"
    xmlns:controls="clr-namespace:EarningsTracker.Controls"
    xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf">

    <!-- Keep the supplied surfaces when disabled behind a modal. The Windows
         theme's list templates otherwise replace Background with white. -->
    <Style TargetType="ListBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="1" SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsGrouping" Value="True"/>
                                <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListView" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="1" SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                      controls:SmoothScroll.IsEnabled="True"
                                      Style="{DynamicResource {x:Static GridView.GridViewScrollViewerStyleKey}}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsGrouping" Value="True"/>
                                <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButton" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,12"/>
        <Setter Property="MinHeight" Value="76"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCompactBody}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid>
                        <Border x:Name="Bd" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true" CornerRadius="{DynamicResource CardCornerRadius}">
                            <Grid x:Name="NavigationLayout">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="NavigationIconColumn" Width="*"/>
                                    <ColumnDefinition x:Name="NavigationLabelColumn" Width="0"/>
                                </Grid.ColumnDefinitions>
                                <fluent:SymbolIcon x:Name="NavigationIcon" Symbol="Home" Width="24" Height="24" FontSize="24" HorizontalAlignment="Center"
                                                   Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False"
                                                   Focusable="False" VerticalAlignment="Center"/>
                                <ContentPresenter x:Name="NavigationCaption" Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <Border x:Name="SelectionMarker" Width="3" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" Background="{DynamicResource AccentColor}" CornerRadius="2" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Static enums:NavigationPage.Sessions}">
                            <Setter TargetName="NavigationIcon" Property="Symbol" Value="History"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static enums:NavigationPage.Games}">
                            <Setter TargetName="NavigationIcon" Property="Symbol" Value="Games"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static enums:NavigationPage.Payments}">
                            <Setter TargetName="NavigationIcon" Property="Symbol" Value="Payment"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static enums:NavigationPage.Statistics}">
                            <Setter TargetName="NavigationIcon" Property="Symbol" Value="ChartMultiple"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static enums:NavigationPage.Settings}">
                            <Setter TargetName="NavigationIcon" Property="Symbol" Value="Settings"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource ControlHoverColor}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource AccentBackgroundColor}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DefaultTextColor}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter TargetName="NavigationIconColumn" Property="Width" Value="20"/>
                            <Setter TargetName="NavigationLabelColumn" Property="Width" Value="*"/>
                            <Setter TargetName="NavigationIcon" Property="Width" Value="20"/>
                            <Setter TargetName="NavigationIcon" Property="Height" Value="20"/>
                            <Setter TargetName="NavigationIcon" Property="FontSize" Value="20"/>
                            <Setter TargetName="NavigationCaption" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="NavigationCaption" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="NavigationCaption" Property="Margin" Value="12,0,0,0"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                <Condition Binding="{Binding UseCompactNavigationSpacing, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="NavigationIcon" Property="Width" Value="20"/>
                            <Setter TargetName="NavigationIcon" Property="Height" Value="20"/>
                            <Setter TargetName="NavigationIcon" Property="FontSize" Value="20"/>
                            <Setter TargetName="NavigationCaption" Property="Margin" Value="0,6,0,0"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="SelectionMarker" Property="Opacity" Value="1"/>
                        </MultiDataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="TextElement.Foreground" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{Binding IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                    <Condition Binding="{Binding UseCompactNavigationSpacing, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Padding" Value="8"/><Setter Property="MinHeight" Value="60"/>
                <Setter Property="Margin" Value="0,2"/>
            </MultiDataTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource DefaultTextColor}"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TableRow" TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource DefaultTextColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DefaultBorderColor}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="5,7"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- Own the row visuals so Windows selection colors cannot replace the app theme. -->
                <ControlTemplate TargetType="ListViewItem">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <Border x:Name="KeyboardFocusBorder" BorderBrush="{DynamicResource AccentColor}" BorderThickness="1"
                                Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlBackgroundColor}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentBackgroundColor}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="KeyboardFocusBorder" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ItemButton" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource DefaultTextColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DefaultBorderColor}"/>
        <Setter Property="Padding" Value="15 8 10 8"/>
        <Setter Property="Margin" Value="0 3 0 3"/>
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15px"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true" CornerRadius="{DynamicResource CardCornerRadius}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource ControlBackgroundColor}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource AccentBackgroundColor}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="TextElement.Foreground" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{Binding Game.IsArchived}" Value="True">
                <Setter Property="Opacity" Value="0.5"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Games retain the existing card template, with one compact inset and readable archived actions. -->
    <Style x:Key="GameCardItem" TargetType="ListBoxItem" BasedOn="{StaticResource ItemButton}">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Game.Name, StringFormat=Open details for {0}}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Game.IsArchived}" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </DataTrigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GameSessionItem" TargetType="ListBoxItem" BasedOn="{StaticResource ItemButton}">
        <Setter Property="Background" Value="{DynamicResource DefaultBackgroundColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource DefaultBorderColor}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true" CornerRadius="{DynamicResource CardCornerRadius}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameButton"
       TargetType="ListBoxItem"
       BasedOn="{StaticResource ItemButton}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Game.IsArchived}" Value="True">
                <Setter Property="Opacity" Value="0.5"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterItemListBox" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="Margin" Value="10 0 0 0"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterListBoxItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisual}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Padding" Value="10 4"/>
        <Setter Property="Margin" Value="2 0"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DefaultBorderColor}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBackgroundColor}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentTextColor}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TableColumnHeader" TargetType="GridViewColumnHeader">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DefaultBorderColor}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="8,12"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBadge}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CompactTableColumnHeader" TargetType="GridViewColumnHeader" BasedOn="{StaticResource TableColumnHeader}">
        <Setter Property="Padding" Value="7,10"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>
</ResourceDictionary>
