<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Compatibility entry point. Keep existing keys available to all views. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml"/>
        <ResourceDictionary Source="Typography.xaml"/>
        <ResourceDictionary Source="Controls.xaml"/>
        <ResourceDictionary Source="Calendar.xaml"/>
        <ResourceDictionary Source="ListsAndTables.xaml"/>
        <ResourceDictionary Source="Panels.xaml"/>
        <ResourceDictionary Source="Dialogs.xaml"/>
        <ResourceDictionary Source="Presentation.xaml"/>
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
