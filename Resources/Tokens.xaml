<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:nerve_earnings_tracker.Utilities"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Palette and geometry retain the existing visual identity. -->
    <FontFamily x:Key="AppFont">/nerve-earnings-tracker;component/Resources/Fonts/#Inter</FontFamily>
    <SolidColorBrush x:Key="SurfaceColor">#17171B</SolidColorBrush>
    <SolidColorBrush x:Key="CardBackgroundColor">#1A1A1E</SolidColorBrush>
    <SolidColorBrush x:Key="SidebarBackgroundColor">#141417</SolidColorBrush>
    <SolidColorBrush x:Key="DialogBackgroundColor">#202024</SolidColorBrush>
    <SolidColorBrush x:Key="InputBackgroundColor">#121215</SolidColorBrush>
    <SolidColorBrush x:Key="ControlBackgroundColor">#26262B</SolidColorBrush>
    <SolidColorBrush x:Key="ControlHoverColor">#303035</SolidColorBrush>
    <SolidColorBrush x:Key="ControlBorderColor">#3A3A40</SolidColorBrush>
    <SolidColorBrush x:Key="ControlHoverBorderColor">#4A4A50</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollThumbColor">#3A3A42</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollThumbHoverColor">#5A5A66</SolidColorBrush>
    <sys:Double x:Key="FontSizePageTitle">25</sys:Double>
    <sys:Double x:Key="FontSizeSectionTitle">16</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeCompactBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSupporting">12</sys:Double>
    <sys:Double x:Key="FontSizeBadge">11</sys:Double>
    <sys:Double x:Key="FontSizeMetric">30</sys:Double>
    <sys:Double x:Key="SpacingSmall">4</sys:Double>
    <sys:Double x:Key="SpacingMedium">8</sys:Double>
    <sys:Double x:Key="SpacingLarge">12</sys:Double>
    <sys:Double x:Key="SpacingSection">16</sys:Double>
    <sys:Double x:Key="SpacingPage">20</sys:Double>
    <sys:Double x:Key="SpacingExtraLarge">24</sys:Double>
    <Thickness x:Key="PageInset">20</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="CompactPanelPadding">12</Thickness>
    <Thickness x:Key="StandardPanelPadding">16</Thickness>
    <Thickness x:Key="ButtonPadding">15,8</Thickness>
    <Thickness x:Key="FieldPadding">10,8</Thickness>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CompactPanelCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="DialogCornerRadius">12</CornerRadius>
    <SolidColorBrush x:Key="DefaultTextColor">#F0F0F2</SolidColorBrush>

    <SolidColorBrush x:Key="DefaultBorderColor">#2A2A30</SolidColorBrush>

    <SolidColorBrush x:Key="DefaultBackgroundColor">#0A0A0b</SolidColorBrush>

    <SolidColorBrush x:Key="SecondaryTextColor" Color="{x:Static ui:PresentationPalette.NeutralText}"/>

    <SolidColorBrush x:Key="VerifiedTextColor" Color="{x:Static ui:PresentationPalette.SuccessText}"/>

    <SolidColorBrush x:Key="RejectedTextColor" Color="{x:Static ui:PresentationPalette.ErrorText}"/>

    <SolidColorBrush x:Key="PendingTextColor" Color="{x:Static ui:PresentationPalette.WarningText}"/>

    <SolidColorBrush x:Key="NotUploadedTextColor" Color="{x:Static ui:PresentationPalette.NeutralText}"/>

    <SolidColorBrush x:Key="VerifiedBackgroundColor" Color="{x:Static ui:PresentationPalette.SuccessBackground}"/>

    <SolidColorBrush x:Key="RejectedBackgroundColor" Color="{x:Static ui:PresentationPalette.ErrorBackground}"/>

    <SolidColorBrush x:Key="PendingBackgroundColor" Color="{x:Static ui:PresentationPalette.WarningBackground}"/>

    <SolidColorBrush x:Key="NotUploadedBackgroundColor" Color="{x:Static ui:PresentationPalette.NeutralBackground}"/>

    <SolidColorBrush x:Key="ArchivedTextColor">#D4A84F</SolidColorBrush>

    <SolidColorBrush x:Key="ArchivedBackgroundColor">#1E1B0C</SolidColorBrush>

    <SolidColorBrush x:Key="AccentTextColor">#9BA0FF</SolidColorBrush>

    <SolidColorBrush x:Key="AccentBackgroundColor">#1D1F3A</SolidColorBrush>

    <SolidColorBrush x:Key="AccentHoverColor">#8B91FF</SolidColorBrush>

    <SolidColorBrush x:Key="AccentColor">#7C83FF</SolidColorBrush>

    <SolidColorBrush x:Key="TextOnAccentColor">#121215</SolidColorBrush>

</ResourceDictionary>
