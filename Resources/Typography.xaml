<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DefaultTextColor}"/>
    </Style>

    <Style x:Key="TabName" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DefaultTextColor}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizePageTitle}"/>
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DefaultTextColor}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSectionTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="CompactSectionHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DefaultTextColor}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="ItemTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeading}">
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="ItemSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCompactBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}"/>
    </Style>

    <Style x:Key="GameSessionDetailsStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSupporting}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="IBeam"/>
    </Style>

    <Style x:Key="DashboardStatLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="DashboardStatValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeMetric}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="0 3"/>
    </Style>

    <Style x:Key="DashboardStatDescription" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSupporting}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="GameDetailPanelLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="GameDetailPanelValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeMetric}"/>
        <Setter Property="Foreground" Value="{DynamicResource DefaultTextColor}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="0 7"/>
    </Style>

    <Style x:Key="GameDetailPanelDescription" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSupporting}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="FilterLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSupporting}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DialogBusyText" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,8"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}"/>
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
    </Style>

    <Style x:Key="InputValidationText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSupporting}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="Foreground" Value="{DynamicResource RejectedTextColor}"/>
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
    </Style>
    <!-- Bound validation for inline editors; empty errors should not reserve space. -->
    <Style x:Key="InlineValidationText" TargetType="TextBlock" BasedOn="{StaticResource InputValidationText}">
        <Setter Property="Visibility" Value="Visible"/>
        <Style.Triggers>
            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="EmptyStateText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="MaxWidth" Value="400"/>
        <Setter Property="Margin" Value="16"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
</ResourceDictionary>
