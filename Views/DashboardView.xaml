<UserControl x:Class="EarningsTracker.Views.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:EarningsTracker.Controls" SizeChanged="Dashboard_SizeChanged">
 <UserControl.Resources>
  <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource ItemSubtitle}"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="DashboardLink" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Foreground" Value="{StaticResource AccentTextColor}"/><Setter Property="Padding" Value="0,2"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
 </UserControl.Resources>
 <Grid Style="{StaticResource TabMainGrid}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Dashboard" Style="{StaticResource TabName}"/><TextBlock Text="Your playtime, translated into earnings." Style="{StaticResource PageDescription}"/><TextBlock Text="{Binding RangeLabel}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
   <ComboBox x:Name="PeriodSelector" Grid.Column="1" Width="120" VerticalAlignment="Center" SelectedIndex="1" SelectionChanged="Period_Changed" AutomationProperties.Name="Dashboard period">
    <ComboBoxItem Content="7 days"/><ComboBoxItem Content="30 days"/><ComboBoxItem Content="90 days"/>
   </ComboBox>
  </Grid>
  <Border x:Name="LoadStatusPanel" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource FeedbackPanel}"><DockPanel>
   <Button x:Name="RetryLoadButton" DockPanel.Dock="Right" Content="Retry" AutomationProperties.Name="Retry loading Dashboard" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Click="RetryLoadButton_Click"/>
   <TextBlock x:Name="LoadStatusText" Style="{StaticResource Caption}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
  </DockPanel></Border>
  <ScrollViewer x:Name="TotalsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="TotalsPanel" Visibility="Collapsed">
    <ItemsControl ItemsSource="{Binding Metrics}" Margin="-4,0,-4,8">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource MetricPanel}" Margin="4,0,4,8" Padding="12" MinHeight="128"><StackPanel>
      <TextBlock Text="{Binding Label}" Style="{StaticResource DashboardStatLabel}" FontSize="12"/>
      <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="36" Margin="0,4"><TextBlock Text="{Binding Value}" Style="{StaticResource DashboardStatValue}" Foreground="{Binding ValueBrush}"/></Viewbox>
      <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"/>
     </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding BalanceDescription}" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
    <Grid x:Name="AnalysisGrid" Margin="0,0,0,16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border x:Name="TrendPanel" Style="{StaticResource SurfacePanel}"><StackPanel>
      <TextBlock Text="Earnings over time" Style="{StaticResource SectionHeading}"/>
      <TextBlock Text="Earned (purple): verified sessions + signed separate adjustments. Pending (dashed amber) is separate. Daily USD." Style="{StaticResource Caption}" Margin="0,4,0,8"/>
      <controls:DashboardEarningsChart x:Name="TrendChart" Days="{Binding Trend}" Height="180"/>
      <TextBlock x:Name="TrendEmptyState" Text="No earnings activity in this period. Recorded zero or offsetting earnings still appear on the chart." Style="{StaticResource Caption}" Visibility="Collapsed"/>
      <Expander x:Name="DailyValues" Header="Daily values" Margin="0,8,0,0"><ListBox ItemsSource="{Binding Trend}" Height="140" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Daily earnings and adjustments">
       <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox></Expander>
     </StackPanel></Border>
     <Border x:Name="DistributionPanel" Grid.Column="2" Style="{StaticResource SurfacePanel}"><StackPanel>
      <TextBlock Text="Session mix" Style="{StaticResource SectionHeading}"/><TextBlock Text="{Binding SessionCountLabel}" Style="{StaticResource Caption}" Margin="0,4,0,10"/>
      <TextBlock Text="{Binding VerifiedShare}" FontSize="30" FontWeight="SemiBold"/>
      <ProgressBar Value="{Binding VerifiedPercent, Mode=OneWay}" Style="{StaticResource MetricProgressBar}" Margin="0,8,0,12" AutomationProperties.Name="Percentage of period sessions verified"/>
      <ItemsControl ItemsSource="{Binding Statuses}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,0,0,8"><TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}" Margin="8,0,0,0"/><TextBlock Text="{Binding Description}" Foreground="{Binding Color}" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="Share uses all period session counts. Amounts are stored session earnings by status; rejected/not uploaded amounts are not earned. Adjustments are separate." Style="{StaticResource Caption}"/>
     </StackPanel></Border>
    </Grid>
    <Grid x:Name="RecordingsPanel" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border x:Name="ActivityPanel" Style="{StaticResource SurfacePanel}"><StackPanel>
      <DockPanel><Button DockPanel.Dock="Right" Content="Sessions →" Style="{StaticResource SecondaryButton}" Click="ViewAllSessions_Click" AutomationProperties.Name="View all sessions"/><TextBlock Text="Recent activity" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/></DockPanel>
      <TextBlock Text="Latest five period recordings. Open a linked game for its full history." Style="{StaticResource Caption}" Margin="0,8"/>
      <ListBox x:Name="SessionsList" ItemsSource="{Binding RecentSessions}" Height="240" ItemContainerStyle="{StaticResource ItemButton}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Recent sessions" SelectionChanged="SessionsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="52" Background="{StaticResource ArchivedBackgroundColor}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" VerticalAlignment="Center" ClipToBounds="True">
                                <ContentControl Style="{StaticResource ArtworkPresenter}" Content="{Binding Cover}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Session.GameName}" Style="{StaticResource ItemTitle}" Margin="0 4"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Session.GameName}"/>
                                <TextBlock Style="{StaticResource GameSessionDetailsStyle}" TextWrapping="Wrap">
                                    <Run Text="{Binding Session.Date, StringFormat='{}{0:MMM d, yyyy}'}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Session.Date, StringFormat='{}{0:h:mm tt}'}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Session.Duration, StringFormat='{}{0:%h}h {0:mm}m'}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock FontSize="{StaticResource FontSizeSectionTitle}" FontWeight="SemiBold"
                                           TextAlignment="Right" Margin="0 4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Session.Earnings, StringFormat={}{0:+$0.00}, ConverterCulture=en-US}"/>
                                            <Setter Property="Foreground" Value="{StaticResource DefaultTextColor}"/>
                                            <Style.Triggers>
                                                <!-- Preserve the Dashboard amount's existing status/duration precedence. -->
                                                <DataTrigger Binding="{Binding Session.Status}" Value="Rejected">
                                                    <Setter Property="Text" Value="Rejected"/>
                                                    <Setter Property="Foreground" Value="{StaticResource RejectedTextColor}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Session.Status}" Value="NotUploaded">
                                                    <Setter Property="Text" Value="Not Uploaded"/>
                                                    <Setter Property="Foreground" Value="{StaticResource NotUploadedTextColor}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Session.Duration}" Value="00:00:00">
                                                    <Setter Property="Text" Value="Below minimum time"/>
                                                    <Setter Property="Foreground" Value="{StaticResource PendingTextColor}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Style="{StaticResource DashboardSessionStatusBadge}" CornerRadius="4"
                                        HorizontalAlignment="Right" Padding="5,1">
                                    <TextBlock Style="{StaticResource DetailedSessionStatusText}" DataContext="{Binding Session}"
                                               FontSize="{StaticResource FontSizeSupporting}" FontWeight="Normal" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="DashboardViewEmptyState" Text="No sessions in this period. Choose Sessions to inspect or import recordings." Style="{StaticResource EmptyStateText}" Visibility="Collapsed"/>
     </StackPanel></Border>
     <Border x:Name="GamesPanel" Grid.Column="2" Style="{StaticResource SurfacePanel}"><StackPanel>
      <TextBlock Text="Top earning games" Style="{StaticResource SectionHeading}"/><TextBlock Text="Verified session earnings · period USD. Bars compare with the highest game; adjustments are not attributed to games." Style="{StaticResource Caption}" Margin="0,4,0,12"/>
      <ItemsControl ItemsSource="{Binding TopGames}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ContentControl Style="{StaticResource ArtworkPresenter}" Content="{Binding Artwork.Cover}" Width="44" Height="52" VerticalAlignment="Top"/>
       <StackPanel Grid.Column="1"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Amount}" Margin="8,3,0,0"/><Button Content="{Binding Name}" ToolTip="{Binding Name}" IsEnabled="{Binding CanNavigate}" Style="{StaticResource DashboardLink}" Click="TopGame_Click"/></DockPanel>
        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,3,0,5"/><ProgressBar Value="{Binding Share, Mode=OneWay}" Style="{StaticResource MetricProgressBar}" Height="4" AutomationProperties.Name="Earnings relative to the top game"/>
       </StackPanel>
      </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="{Binding GameAttributionNotice}" Style="{StaticResource Caption}"/>
     </StackPanel></Border>
    </Grid>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
