<UserControl x:Class="EarningsTracker.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EarningsTracker.Controls"
             SizeChanged="Dashboard_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource ItemSubtitle}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSupporting}"/>
        </Style>
        <Style x:Key="DashboardHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionHeading}">
            <Setter Property="FontSize" Value="24"/>
        </Style>
        <Style x:Key="DashboardLink" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="{StaticResource AccentTextColor}"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource DefaultBorderColor}"/>
            <Setter Property="Margin" Value="0,20"/>
        </Style>
        <Style x:Key="RecentSessionRow" TargetType="ListBoxItem" BasedOn="{StaticResource ItemButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Session.GameName, StringFormat=Open game details for {0}}"/>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource TabMainGrid}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Dashboard" Style="{StaticResource TabName}" FontSize="32" VerticalAlignment="Center"/>
            <Button x:Name="ImportSessionsButton" Grid.Column="1" Content="Import sessions" Click="ImportSessions_Click" Style="{StaticResource PrimaryButton}"/>
        </Grid>
        <Border x:Name="LoadStatusPanel" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource FeedbackPanel}">
            <DockPanel>
                <Button x:Name="RetryLoadButton" DockPanel.Dock="Right" Content="Retry" AutomationProperties.Name="Retry loading Dashboard"
                        Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Click="RetryLoadButton_Click"/>
                <TextBlock x:Name="LoadStatusText" Style="{StaticResource Caption}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="TotalsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="TotalsPanel" Visibility="Collapsed">
                <Border x:Name="GettingStarted" Style="{StaticResource SurfacePanel}" Margin="0,0,0,24" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Start tracking your earnings" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Text="Copy complete recordings from Nerve’s Recordings page, then preview and import them here. Your source values and history are kept."
                                   Style="{StaticResource PageDescription}" Margin="0,8,0,12"/>
                        <Button Content="Import payouts" Click="ImportPayouts_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Grid x:Name="AccountSummary" AutomationProperties.Name="All-time account summary in USD">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="All time · USD" Style="{StaticResource Caption}"/>
                        <Viewbox Height="48" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,4,0,0">
                            <TextBlock x:Name="BalanceValue" Text="{Binding BalanceDisplay}" FontSize="40" FontWeight="SemiBold"/>
                        </Viewbox>
                        <TextBlock Text="Unpaid verified earnings" FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="{StaticResource DefaultBorderColor}" BorderThickness="1,0,0,0" Margin="0,16,24,8"/>
                    <StackPanel Grid.Column="1" Margin="24,16,24,0">
                        <TextBlock Text="Paid" Style="{StaticResource DashboardStatLabel}"/>
                        <Viewbox Height="40" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,4,0,0">
                            <TextBlock x:Name="PaidValue" Text="{Binding PaidDisplay}" Style="{StaticResource DashboardStatValue}" Foreground="{StaticResource DefaultTextColor}"/>
                        </Viewbox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,16,0,0">
                        <TextBlock Text="Processing" Style="{StaticResource DashboardStatLabel}"/>
                        <Viewbox Height="40" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,4,0,0">
                            <TextBlock x:Name="ProcessingValue" Text="{Binding ProcessingDisplay}" Style="{StaticResource DashboardStatValue}" Foreground="{StaticResource DefaultTextColor}"/>
                        </Viewbox>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Recorded earnings awaiting payment; not a withdrawal confirmation. Independent of the period below."
                           Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                <TextBlock Text="Processing is not confirmation of receipt." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                <TextBlock x:Name="BalanceExclusions" Text="{Binding BalanceExclusionNotice}" Margin="0,8,0,0"
                           Foreground="{StaticResource PendingTextColor}" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Style="{StaticResource SectionDivider}"/>
                <Grid x:Name="PeriodOverviewHeader" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Period overview" Style="{StaticResource DashboardHeading}"/>
                        <TextBlock Text="{Binding RangeLabel}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="PeriodSelector" Grid.Column="1" Width="156" VerticalAlignment="Top" Style="{StaticResource FilterDropdown}"
                              SelectedIndex="3" SelectionChanged="Period_Changed" AutomationProperties.Name="Dashboard period">
                        <ComboBoxItem Content="7 days"/><ComboBoxItem Content="30 days"/><ComboBoxItem Content="90 days"/>
                        <ComboBoxItem Content="Current payout" Tag="Payout"/>
                    </ComboBox>
                </Grid>
                <ItemsControl x:Name="MetricCards" ItemsSource="{Binding Metrics}" Margin="-8,0,-8,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding MetricColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="8,0,8,12" Padding="0" Background="Transparent">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource DashboardStatLabel}"/>
                                    <Viewbox Height="40" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,4">
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource DashboardStatValue}" Foreground="{Binding ValueBrush}"/>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Expander x:Name="CalculationDetails" Header="How calculated" AutomationProperties.Name="Dashboard calculation details">
                    <StackPanel>
                        <TextBlock Text="Earned includes verified sessions and eligible separate bonuses/corrections. Pending is separate. Session dates use recording dates; adjustments and payments use transaction dates."
                                   Style="{StaticResource Caption}" Margin="0,8,0,6"/>
                        <TextBlock Text="{Binding BalanceDescription}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="Session mix counts all statuses. Top games use verified session earnings, exclude adjustments, and compare bars with the highest earner."
                                   Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Expander>

                <Grid x:Name="AnalysisGrid">
                    <Border x:Name="TrendPanel" BorderBrush="{StaticResource DefaultBorderColor}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Earnings over time" Style="{StaticResource DashboardHeading}"/>
                            <DockPanel Margin="0,12,0,4">
                                <TextBlock DockPanel.Dock="Right" Text="USD · Today is incomplete" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                        <Border Width="10" Height="10" Background="{StaticResource AccentColor}" CornerRadius="2" Margin="0,0,6,0"/>
                                        <TextBlock Text="Earned" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="10" Background="{StaticResource PendingTextColor}" CornerRadius="2" Margin="0,0,6,0"/>
                                        <TextBlock Text="Pending" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </WrapPanel>
                            </DockPanel>
                            <controls:DashboardEarningsChart x:Name="TrendChart" Days="{Binding Trend}" Height="140"/>
                            <TextBlock x:Name="TrendEmptyState" Text="No earnings activity in this period." Style="{StaticResource Caption}" Visibility="Collapsed" Margin="0,16"/>
                            <Expander x:Name="DailyValues" Header="Daily values">
                                <ListBox ItemsSource="{Binding Trend}" Height="140" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                         AutomationProperties.Name="Daily earnings and adjustments">
                                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"/></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </Expander>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="RecordingsPanel" Visibility="Collapsed">
                    <Border x:Name="ActivityPanel" BorderBrush="{StaticResource DefaultBorderColor}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="ViewSessionsButton" DockPanel.Dock="Right" Content="View sessions →" Style="{StaticResource DashboardLink}"
                                        Click="ViewAllSessions_Click" AutomationProperties.Name="View all sessions"/>
                                <TextBlock Text="Recent sessions" Style="{StaticResource DashboardHeading}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid Margin="8,0,24,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3.2*"/><ColumnDefinition x:Name="RecentRecordedColumn" Width="1.9*"/>
                                    <ColumnDefinition x:Name="RecentDurationColumn" Width="1.8*"/>
                                    <ColumnDefinition x:Name="RecentEarningsColumn" Width="1.4*" MinWidth="150"/>
                                    <ColumnDefinition x:Name="RecentStatusColumn" Width="1.4*" MinWidth="136"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Game" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="RecentRecordedHeader" Grid.Column="1" Text="Recorded" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="RecentDurationHeader" Grid.Column="2" Text="Duration" Style="{StaticResource Caption}"/>
                                <TextBlock Grid.Column="3" Text="Earnings · USD" Style="{StaticResource Caption}" TextAlignment="Right" Margin="0,0,16,0"/>
                                <TextBlock Grid.Column="4" Text="Status" Style="{StaticResource Caption}" Margin="16,0,0,0"/>
                            </Grid>
                            <ListBox x:Name="SessionsList" ItemsSource="{Binding RecentSessions}" Height="240" ItemContainerStyle="{StaticResource RecentSessionRow}"
                                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Recent sessions" SelectionChanged="SessionsList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3.2*"/><ColumnDefinition x:Name="RecordedColumn" Width="1.9*"/>
                                                <ColumnDefinition x:Name="DurationColumn" Width="1.8*"/>
                                                <ColumnDefinition x:Name="EarningsColumn" Width="1.4*" MinWidth="150"/>
                                                <ColumnDefinition x:Name="StatusColumn" Width="1.4*" MinWidth="136"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Margin="0,0,16,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="36" Height="44" Background="{StaticResource ArchivedBackgroundColor}"
                                                        CornerRadius="{StaticResource ControlCornerRadius}" ClipToBounds="True">
                                                    <ContentControl Style="{StaticResource ArtworkPresenter}" Content="{Binding Cover}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Session.GameName}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Session.GameName}"/>
                                                    <TextBlock x:Name="CompactRecording" Visibility="Collapsed" Style="{StaticResource Caption}" Margin="0,4,0,0">
                                                        <Run Text="{Binding Session.DateTimeText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Session.DurationText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="RecordedValue" Grid.Column="1" Text="{Binding Session.DateTimeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <TextBlock x:Name="DurationValue" Grid.Column="2" Text="{Binding Session.DurationText}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                                       TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Session.Earnings, StringFormat={}{0:+$0.00}, ConverterCulture=en-US}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource DefaultTextColor}"/>
                                                        <Style.Triggers>
                                                            <!-- Preserve the existing Dashboard amount/status precedence. -->
                                                            <DataTrigger Binding="{Binding Session.Status}" Value="Rejected">
                                                                <Setter Property="Text" Value="Rejected"/><Setter Property="Foreground" Value="{StaticResource RejectedTextColor}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Session.Status}" Value="NotUploaded">
                                                                <Setter Property="Text" Value="Not Uploaded"/><Setter Property="Foreground" Value="{StaticResource NotUploadedTextColor}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Session.Duration}" Value="00:00:00">
                                                                <Setter Property="Text" Value="Below minimum time"/><Setter Property="Foreground" Value="{StaticResource PendingTextColor}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Grid.Column="4" Style="{StaticResource DashboardSessionStatusBadge}" CornerRadius="{StaticResource ControlCornerRadius}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Left" Padding="8,4" Margin="16,0,0,0">
                                                <TextBlock Style="{StaticResource DetailedSessionStatusText}" DataContext="{Binding Session}"
                                                           FontSize="{StaticResource FontSizeSupporting}" FontWeight="Normal" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter TargetName="RecordedColumn" Property="Width" Value="0"/>
                                                <Setter TargetName="DurationColumn" Property="Width" Value="0"/>
                                                <Setter TargetName="EarningsColumn" Property="Width" Value="150"/>
                                                <Setter TargetName="StatusColumn" Property="Width" Value="136"/>
                                                <Setter TargetName="RecordedValue" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="DurationValue" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="CompactRecording" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="DashboardViewEmptyState" Text="No sessions in this period." Style="{StaticResource EmptyStateText}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Expander x:Name="MoreInsights" Header="More insights" Margin="0,24,0,0" AutomationProperties.Name="Session mix and top earning games">
                    <Grid x:Name="InsightsGrid" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border x:Name="DistributionPanel" Style="{StaticResource SurfacePanel}">
                            <StackPanel>
                                <TextBlock Text="Session mix" Style="{StaticResource SectionHeading}"/>
                                <TextBlock Text="{Binding SessionCountLabel}" Style="{StaticResource Caption}" Margin="0,4,0,10"/>
                                <TextBlock Text="{Binding VerifiedShare}" Style="{StaticResource DashboardStatValue}" Foreground="{StaticResource DefaultTextColor}"/>
                                <ProgressBar Value="{Binding VerifiedPercent, Mode=OneWay}" Style="{StaticResource MetricProgressBar}" Margin="0,8,0,12"
                                             AutomationProperties.Name="Percentage of period sessions verified"/>
                                <ItemsControl ItemsSource="{Binding Statuses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{Binding Color}" TextWrapping="Wrap"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Rejected and not uploaded amounts aren’t earned." Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="GamesPanel" Grid.Column="2" Style="{StaticResource SurfacePanel}">
                            <StackPanel>
                                <TextBlock Text="Top earning games" Style="{StaticResource SectionHeading}"/>
                                <TextBlock Text="Verified session earnings · USD" Style="{StaticResource Caption}" Margin="0,4,0,12"/>
                                <ItemsControl ItemsSource="{Binding TopGames}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <ContentControl Style="{StaticResource ArtworkPresenter}" Content="{Binding Artwork.Cover}" Width="44" Height="52" VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="1">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Amount}" Margin="8,6,0,0"/>
                                                        <Button Content="{Binding Name}" ToolTip="{Binding Name}" IsEnabled="{Binding CanNavigate}"
                                                                Style="{StaticResource DashboardLink}" Click="TopGame_Click"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,3,0,5"/>
                                                    <ProgressBar Value="{Binding Share, Mode=OneWay}" Style="{StaticResource MetricProgressBar}" Height="4"
                                                                 AutomationProperties.Name="Earnings relative to the top game"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding GameAttributionNotice}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
