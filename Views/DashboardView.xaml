<UserControl x:Class="nerve_earnings_tracker.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="688" d:DesignWidth="1000"
             SizeChanged="Dashboard_SizeChanged">
    <Grid Style="{StaticResource TabMainGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Dashboard" Style="{StaticResource TabName}" Margin="0 0 0 20"/>
        <Border x:Name="LoadStatusPanel" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource FeedbackPanel}">
            <DockPanel>
                <Button x:Name="RetryLoadButton" DockPanel.Dock="Right" Content="Retry"
                        AutomationProperties.Name="Retry loading Dashboard"
                        Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Click="RetryLoadButton_Click"/>
                <TextBlock x:Name="LoadStatusText" Style="{StaticResource ItemSubtitle}" TextWrapping="Wrap"
                           VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </Border>
        <Grid x:Name="TotalsPanel" Grid.Row="2" Visibility="Collapsed">
            <!-- Only the metric region scrolls; recent sessions retain their own bounded viewport. -->
            <ScrollViewer x:Name="TotalsScroll" MaxHeight="300" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0" Margin="-4,0,-4,0">
                <UniformGrid x:Name="MetricCards" Columns="2">
                    <Border Style="{StaticResource MetricPanel}" BorderBrush="{StaticResource DefaultBorderColor}"
                            Padding="{StaticResource StandardPanelPadding}" Margin="4,0,4,8">
                        <StackPanel>
                            <TextBlock Text="Balance" Style="{StaticResource DashboardStatLabel}"/>
                            <TextBlock Text="{Binding Balance, StringFormat={}{0:C2}, ConverterCulture=en-US}" Style="{StaticResource DashboardStatValue}"
                                       Foreground="{StaticResource VerifiedTextColor}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding BalanceDescription}" Style="{StaticResource DashboardStatDescription}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricPanel}" BorderBrush="{StaticResource DefaultBorderColor}"
                            Padding="{StaticResource StandardPanelPadding}" Margin="4,0,4,8">
                        <StackPanel>
                            <TextBlock Text="Total Paid Out" Style="{StaticResource DashboardStatLabel}"/>
                            <TextBlock Text="{Binding TotalPaidOut, StringFormat={}{0:C2}, ConverterCulture=en-US}" Style="{StaticResource DashboardStatValue}"
                                       Foreground="{StaticResource DefaultTextColor}" TextWrapping="Wrap"/>
                            <TextBlock Text="Paid and processing payments" Style="{StaticResource DashboardStatDescription}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="RecordingsPanel" Grid.Row="3" Visibility="Collapsed" Margin="0 12 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource SurfacePanel}" Margin="0 0 0 12">
                <TextBlock Style="{StaticResource ItemSubtitle}" TextWrapping="Wrap">
                    <Run Text="{Binding TotalSessions, Mode=OneWay, StringFormat={}{0:N0} sessions}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding TotalHoursPlayed, Mode=OneWay, StringFormat={}{0:N1} hours played}"/>
                </TextBlock>
            </Border>
            <DockPanel Grid.Row="1" Margin="0 0 0 8">
                <Button DockPanel.Dock="Right" Content="View all" AutomationProperties.Name="View all sessions"
                        Style="{StaticResource SecondaryButton}" Click="ViewAllSessions_Click"/>
                <TextBlock Text="Recent sessions" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
            </DockPanel>
            <ListBox Grid.Row="2" x:Name="SessionsList" ItemsSource="{Binding RecentSessions}"
                     ItemContainerStyle="{StaticResource ItemButton}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                     AutomationProperties.Name="Recent sessions" SelectionChanged="SessionsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="60" Height="72" Background="{StaticResource ArchivedBackgroundColor}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" VerticalAlignment="Center" ClipToBounds="True">
                                <ContentControl Style="{StaticResource ArtworkPresenter}" Content="{Binding Cover}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Session.GameName}" Style="{StaticResource ItemTitle}" Margin="0 4"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Session.GameName}"/>
                                <TextBlock Style="{StaticResource GameSessionDetailsStyle}" TextWrapping="Wrap">
                                    <Run Text="{Binding Session.Date, StringFormat='{}{0:MMM d, yyyy}'}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Session.Date, StringFormat='{}{0:h:mm tt}'}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Session.Duration, StringFormat='{}{0:%h}h {0:mm}m'}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock FontSize="{StaticResource FontSizeSectionTitle}" FontWeight="SemiBold"
                                           TextAlignment="Right" Margin="0 4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Session.Earnings, StringFormat={}{0:+$0.00}, ConverterCulture=en-US}"/>
                                            <Setter Property="Foreground" Value="{StaticResource DefaultTextColor}"/>
                                            <Style.Triggers>
                                                <!-- Preserve the Dashboard amount's existing status/duration precedence. -->
                                                <DataTrigger Binding="{Binding Session.Status}" Value="Rejected">
                                                    <Setter Property="Text" Value="Rejected"/>
                                                    <Setter Property="Foreground" Value="{StaticResource RejectedTextColor}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Session.Status}" Value="NotUploaded">
                                                    <Setter Property="Text" Value="Not Uploaded"/>
                                                    <Setter Property="Foreground" Value="{StaticResource NotUploadedTextColor}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Session.Duration}" Value="00:00:00">
                                                    <Setter Property="Text" Value="Below minimum time"/>
                                                    <Setter Property="Foreground" Value="{StaticResource PendingTextColor}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Style="{StaticResource DashboardSessionStatusBadge}" CornerRadius="4"
                                        HorizontalAlignment="Right" Padding="5,1">
                                    <TextBlock Style="{StaticResource DetailedSessionStatusText}" DataContext="{Binding Session}"
                                               FontSize="{StaticResource FontSizeSupporting}" FontWeight="Normal" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="DashboardViewEmptyState" Grid.Row="2"
                       Text="No sessions yet. Choose View all to import your recordings.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RecentSessions.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>


