<UserControl x:Class="EarningsTracker.Views.Modals.ImportResultModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EarningsTracker.Views.Modals" xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="Root">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="ImportResultGrid">
        <StackPanel x:Name="ResultPanel" HorizontalAlignment="Stretch" VerticalAlignment="Center" Visibility="Collapsed">

            <fluent:FluentIcon
        x:Name="ResultIcon"
        Icon="Checkmark"
        IconVariant="Filled"
        FontSize="48"
        HorizontalAlignment="Center"/>

            <TextBlock x:Name="ResultTitle"
               Style="{StaticResource SectionHeading}"
               AutomationProperties.LiveSetting="Polite"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Margin="0,10,0,0"/>

            <TextBlock x:Name="ResultMessage"
               Style="{StaticResource ItemSubtitle}"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Margin="0,6,0,20"/>

            <WrapPanel HorizontalAlignment="Right">
            <Button x:Name="ResultBackButton" Content="Back to input" Visibility="Collapsed" Margin="0,0,12,0"
                    Style="{StaticResource SecondaryButton}" Click="SummaryBackButton_Click"/>
            <Button Content="Done"
            Style="{StaticResource PrimaryButton}"
            Click="DoneButton_Click"
            HorizontalAlignment="Center"/>
            </WrapPanel>
        </StackPanel>
        <Grid x:Name="PreviewPanel"
        Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource SurfacePanel}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="SessionsFoundText"
                   Style="{StaticResource SectionHeading}"/>
                <TextBlock x:Name="UnlinkedGuidance" Text="Link these sessions in Sessions → Unlinked." Visibility="Collapsed"
                           Style="{StaticResource ItemSubtitle}" TextWrapping="Wrap" Margin="0,8,0,4"/>

                <TextBlock x:Name="NewSessionsText"
                   Margin="0,12,0,0"
                   Foreground="{StaticResource VerifiedTextColor}"
                   FontSize="{StaticResource FontSizeBody}"/>
                <StackPanel x:Name="NewSessionsPayoutPanel" Margin="0,12,0,8">
                    <TextBlock Text="Payout for new sessions" Style="{StaticResource FilterLabel}"/>
                    <ComboBox x:Name="NewSessionsPayout" AutomationProperties.Name="Payout for new sessions"
                              DisplayMemberPath="Label" SelectionChanged="NewSessionsPayout_SelectionChanged" MaxDropDownHeight="300"/>
                    <TextBlock Text="For past sessions, choose the payment that covered them." Style="{StaticResource ItemSubtitle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <TextBlock x:Name="UpdatedSessionsText"
                   Margin="0,4,0,0"
                   Foreground="{StaticResource SecondaryTextColor}"
                   FontSize="{StaticResource FontSizeBody}"/>

                <TextBlock x:Name="AmbiguousSessionsText"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Foreground="{StaticResource PendingTextColor}"
                   FontSize="{StaticResource FontSizeBody}"/>

                <TextBlock x:Name="InvalidSessionsText"
                   Margin="0,4,0,0"
                   Foreground="{StaticResource RejectedTextColor}"
                   FontSize="{StaticResource FontSizeBody}"/>

                <TextBlock x:Name="SkippedSessionsText"
                   Margin="0,4,0,0"
                   Foreground="{StaticResource SecondaryTextColor}"
                   FontSize="{StaticResource FontSizeBody}"/>

                <TextBlock x:Name="TotalEarningsText"
                   Margin="0,20,0,0"
                   Style="{StaticResource SectionHeading}"/>
                <Expander x:Name="ConflictsSection" Header="View conflicts" Visibility="Collapsed" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="These rows won’t be imported. Review their recording or game match."
                                   Style="{StaticResource ItemSubtitle}" TextWrapping="Wrap" Margin="0,8,0,4"/>
                        <ListBox x:Name="ConflictRows" MaxHeight="240" Background="Transparent" BorderThickness="0"
                                 AutomationProperties.Name="Conflicting session import rows"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ItemButton}">
                                    <Setter Property="Padding" Value="8"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="FontSize" Value="{StaticResource FontSizeCompactBody}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource DefaultTextColor}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Expander>
            </StackPanel>
            </Border>
            <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
                <Button Content="Back" Style="{StaticResource SecondaryButton}" Margin="0 0 20 0" Click="SummaryBackButton_Click" />
                <Button Content="Import Sessions" Style="{StaticResource PrimaryButton}" Click="ConfirmImportButton_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
