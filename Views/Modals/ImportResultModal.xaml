<UserControl x:Class="EarningsTracker.Views.Modals.ImportResultModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EarningsTracker.Views.Modals" xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="Root">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="ImportResultGrid">
        <StackPanel x:Name="ResultPanel" HorizontalAlignment="Stretch" VerticalAlignment="Center" Visibility="Collapsed">

            <fluent:FluentIcon
        x:Name="ResultIcon"
        Icon="Checkmark"
        IconVariant="Filled"
        FontSize="48"
        HorizontalAlignment="Center"/>

            <TextBlock x:Name="ResultTitle"
               Style="{StaticResource SectionHeading}"
               AutomationProperties.LiveSetting="Polite"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Margin="0,10,0,0"/>

            <TextBlock x:Name="ResultMessage"
               Style="{StaticResource ItemSubtitle}"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Margin="0,6,0,20"/>

            <WrapPanel HorizontalAlignment="Right">
            <Button x:Name="ResultBackButton" Content="Back to input" Visibility="Collapsed" Margin="0,0,12,0"
                    Style="{StaticResource SecondaryButton}" Click="SummaryBackButton_Click"/>
            <Button Content="Done"
            Style="{StaticResource PrimaryButton}"
            Click="DoneButton_Click"
            HorizontalAlignment="Center"/>
            </WrapPanel>
        </StackPanel>
        <Grid x:Name="PreviewPanel"
        Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource SurfacePanel}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="SessionsFoundText"
                   Style="{StaticResource SectionHeading}"/>
                <TextBlock Text="Review before saving. Ambiguous and invalid recordings are excluded; repeated rows are skipped."
                           Style="{StaticResource ItemSubtitle}" TextWrapping="Wrap" Margin="0,8,0,4"/>

                <TextBlock x:Name="NewSessionsText"
                   Margin="0,12,0,0"
                   Foreground="{StaticResource VerifiedTextColor}"
                   FontSize="{StaticResource FontSizeBody}"/>

                <TextBlock x:Name="UpdatedSessionsText"
                   Margin="0,4,0,0"
                   Foreground="{StaticResource SecondaryTextColor}"
                   FontSize="{StaticResource FontSizeBody}"/>

                <TextBlock x:Name="AmbiguousSessionsText"
                   Margin="0,4,0,0"
                   Foreground="{StaticResource PendingTextColor}"
                   FontSize="{StaticResource FontSizeBody}"/>

                <TextBlock x:Name="InvalidSessionsText"
                   Margin="0,4,0,0"
                   Foreground="{StaticResource RejectedTextColor}"
                   FontSize="{StaticResource FontSizeBody}"/>

                <TextBlock x:Name="SkippedSessionsText"
                   Margin="0,4,0,0"
                   Foreground="{StaticResource SecondaryTextColor}"
                   FontSize="{StaticResource FontSizeBody}"/>

                <TextBlock x:Name="TotalEarningsText"
                   Margin="0,20,0,0"
                   Style="{StaticResource SectionHeading}"/>
            </StackPanel>
            </Border>
            <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
                <Button Content="Back" Style="{StaticResource SecondaryButton}" Margin="0 0 20 0" Click="SummaryBackButton_Click" />
                <Button Content="Import Sessions" Style="{StaticResource PrimaryButton}" Click="ConfirmImportButton_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
