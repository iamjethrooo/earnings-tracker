<Window x:Class="EarningsTracker.Views.Modals.LocalInstallationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local installations" Width="660" Height="540" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{StaticResource DefaultBackgroundColor}"
        Foreground="{StaticResource DefaultTextColor}" FontFamily="{StaticResource AppFont}"
        KeyboardNavigation.TabNavigation="Cycle">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Local installations" Style="{StaticResource SectionHeading}"/>
            <TextBlock Text="Browse titles reported by your enabled sources, including games outside the tracker. Windows registrations can also include other apps." Style="{StaticResource PageDescription}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock x:Name="ScanWarning" Style="{StaticResource PageDescription}" TextWrapping="Wrap"
                       Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="Search" Style="{StaticResource FilterSearchBox}" Tag="Search installed titles" TextChanged="FiltersChanged"
                     AutomationProperties.Name="Search installed titles" ToolTip="Search installed titles by name"/>
            <ComboBox x:Name="SourceFilter" Grid.Column="1" Style="{StaticResource FilterDropdown}" MinWidth="150" Margin="8,0,0,0"
                      SelectionChanged="FiltersChanged" AutomationProperties.Name="Installation source"/>
        </Grid>
        <TextBlock x:Name="ResultStatus" Grid.Row="2" Margin="0,8,0,8" Style="{StaticResource ItemSubtitle}"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <ListBox x:Name="Installations" Grid.Row="3" Background="Transparent" BorderThickness="0"
                 AutomationProperties.Name="Local installation results" HorizontalContentAlignment="Stretch"
                 ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource GameCardItem}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Evidence}" Style="{StaticResource ItemSubtitle}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button Content="Close" IsCancel="True" Click="Close_Click" DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButton}"/>
            <Button Content="Installation settings" Click="Settings_Click" HorizontalAlignment="Left"
                    Style="{StaticResource SecondaryButton}"/>
        </DockPanel>
    </Grid>
</Window>
