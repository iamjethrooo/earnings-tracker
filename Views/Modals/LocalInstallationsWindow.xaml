<Window x:Class="EarningsTracker.Views.Modals.LocalInstallationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Local installations" Width="800" Height="680" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner" Style="{StaticResource UtilityDialogWindow}"
        Foreground="{StaticResource DefaultTextColor}" FontFamily="{StaticResource AppFont}"
        KeyboardNavigation.TabNavigation="Cycle">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Grid>
                <TextBlock Text="Local installations" Style="{StaticResource DialogTitle}" Margin="0,0,42,0"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Padding="6" Click="Close_Click" Style="{StaticResource SecondaryButton}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Close dialog" ToolTip="Close" shell:WindowChrome.IsHitTestVisibleInChrome="True"><fluent:SymbolIcon Symbol="Dismiss" FontSize="20" Focusable="False"/></Button>
            </Grid>
            <TextBlock Text="Titles reported by your enabled sources. Windows registrations may include other apps." Style="{StaticResource PageDescription}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock x:Name="ScanWarning" Style="{StaticResource PageDescription}" Foreground="{StaticResource PendingTextColor}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="Search" Style="{StaticResource FilterSearchBox}" Tag="Search installed titles" TextChanged="FiltersChanged"
                     AutomationProperties.Name="Search installed titles" ToolTip="Search installed titles by name"/>
            <ComboBox x:Name="SourceFilter" Grid.Column="1" Style="{StaticResource FilterDropdown}" MinWidth="150" Margin="8,0,0,0"
                      SelectionChanged="FiltersChanged" AutomationProperties.Name="Installation source"/>
        </Grid>
        <TextBlock x:Name="ResultStatus" Grid.Row="2" Margin="0,8,0,8" Style="{StaticResource ItemSubtitle}"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <ListBox x:Name="Installations" Grid.Row="3" Background="Transparent" BorderThickness="0"
                 AutomationProperties.Name="Local installation results" HorizontalContentAlignment="Stretch"
                 ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource DialogReviewItem}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource DefaultBorderColor}" BorderThickness="0,0,0,1" Padding="8,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <fluent:SymbolIcon Symbol="Desktop" Width="22" Height="22" FontSize="22" Margin="0,0,16,0" Foreground="{StaticResource SecondaryTextColor}" Focusable="False"/>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Evidence}" Style="{StaticResource ItemSubtitle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="4" Style="{StaticResource DialogFooter}"><DockPanel>
            <Button Content="Close" IsCancel="True" Click="Close_Click" DockPanel.Dock="Right"
                    Style="{StaticResource PrimaryButton}"/>
            <Button Content="Installation settings" Click="Settings_Click" HorizontalAlignment="Left"
                    Style="{StaticResource SecondaryButton}"/>
        </DockPanel></Border>
    </Grid>
</Window>
