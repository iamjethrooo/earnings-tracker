<UserControl x:Class="EarningsTracker.Views.Modals.PayoutEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:modal="clr-namespace:EarningsTracker.Controls"
             modal:Modal.OwnsScrolling="True" modal:Modal.ContentMaxWidth="700">
    <Grid SizeChanged="PayoutForm_SizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="BusyStatus" Style="{StaticResource DialogBusyText}"/>
        <ScrollViewer Grid.Row="1" x:Name="EditorScroll" Style="{StaticResource DialogBodyScroll}">
            <StackPanel>
                <TextBlock x:Name="EditorDescription" Text="Update the record and explain any adjustment." FontSize="14" Style="{StaticResource PageDescription}" Margin="0,0,0,24"/>
                <UniformGrid x:Name="DateTypeFields" Columns="2">
                    <StackPanel Margin="0,0,12,20">
                        <TextBlock Text="Date" Style="{StaticResource DialogLabel}"/>
                        <DatePicker AutomationProperties.Name="Date" x:Name="PayoutDate"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Type" Style="{StaticResource DialogLabel}"/>
                        <ComboBox AutomationProperties.Name="Type" x:Name="PayoutType"/>
                    </StackPanel>
                </UniformGrid>
                <TextBlock Text="Description" Style="{StaticResource DialogLabel}"/>
                <TextBox AutomationProperties.Name="Description" x:Name="Description" Style="{StaticResource ModalTextBox}" Margin="0,0,0,20"/>
                <UniformGrid x:Name="StatusAmountFields" Columns="2">
                    <StackPanel Margin="0,0,12,20">
                        <TextBlock Text="Status" Style="{StaticResource DialogLabel}"/>
                        <ComboBox AutomationProperties.Name="Status" x:Name="Status"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Amount (USD)" Style="{StaticResource DialogLabel}"/>
                        <TextBox AutomationProperties.Name="Signed amount (USD)" x:Name="Amount" Style="{StaticResource ModalTextBox}"/>
                        <TextBlock Text="Use a decimal point: 23.84 or -2.50." Style="{StaticResource PageDescription}" Margin="0,6,0,0"/>
                    </StackPanel>
                </UniformGrid>
                <StackPanel x:Name="AdjustmentOptions" Margin="0,0,0,24">
                    <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource ControlBorderColor}" Padding="0,20,0,0" Margin="0,0,0,16">
                        <TextBlock Text="How this affects earnings" Style="{StaticResource ContentHeading}" FontSize="18"/>
                    </Border>
                    <RadioButton Style="{StaticResource DialogRadioButton}" x:Name="IncludedRadio" GroupName="AdjustmentReconciliation"  Foreground="{StaticResource DefaultTextColor}"><TextBlock Text="Already included in session earnings" FontSize="14" TextWrapping="Wrap"/></RadioButton>
                    <TextBlock Text="Not added again." Style="{StaticResource PageDescription}" Margin="30,4,0,16"/>
                    <RadioButton Style="{StaticResource DialogRadioButton}" x:Name="SeparateRadio" GroupName="AdjustmentReconciliation"  Foreground="{StaticResource DefaultTextColor}"><TextBlock Text="Separate from session earnings" FontSize="14" TextWrapping="Wrap"/></RadioButton>
                    <TextBlock Text="Added when Verified, Paid, or Processing. Negative amounts reduce earnings." Style="{StaticResource PageDescription}" Margin="30,4,0,0"/>
                </StackPanel>
                <TextBlock Text="Reason (optional)" Style="{StaticResource DialogLabel}"/>
                <TextBox AutomationProperties.Name="Change reason (optional)" x:Name="Reason" Style="{StaticResource ModalTextBox}" Margin="0,0,0,12"/>
                <TextBlock x:Name="ValidationMessage" Style="{StaticResource InputValidationText}" Margin="0,0,0,12"/>
                <ContentControl x:Name="CoveragePanel"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"/>
                <Button x:Name="SaveButton" Content="Save payout" Click="SaveButton_Click" Style="{StaticResource PrimaryButton}"/>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
