<UserControl x:Class="EarningsTracker.Views.SessionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:enums="clr-namespace:EarningsTracker.Enums"
    SizeChanged="View_SizeChanged" PreviewKeyDown="View_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Show"/>
        <Style x:Key="SessionFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FilterLabel}">
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style x:Key="SessionGameLink" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource AccentTextColor}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0,3"/>
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource AccentTextColor}"/>
            </DataTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="SessionEditorTemplate">
            <StackPanel>
                <TextBlock Text="Editing draft" Style="{StaticResource SectionHeading}" Foreground="{StaticResource PendingTextColor}"/>
                <StackPanel Visibility="{Binding CanSelectGame, Converter={StaticResource Show}}">
                    <TextBlock Text="Link to game" Style="{StaticResource SessionFieldLabel}"/>
                    <ComboBox AutomationProperties.Name="Session game"
                        ItemsSource="{Binding DataContext.AvailableGames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        SelectedItem="{Binding DraftGame, Mode=TwoWay}" MaxDropDownHeight="300">
                        <ComboBox.ItemTemplate><DataTemplate><StackPanel>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            <TextBlock Style="{StaticResource ItemSubtitle}"><Run Text="{Binding RatePerHour, StringFormat={}{0:C2}, ConverterCulture=en-US}"/><Run Text="/hour · "/><Run Text="{Binding MinutesCap}"/><Run Text=" min cap"/></TextBlock>
                            <TextBlock Text="Archived" Style="{StaticResource ItemSubtitle}" Visibility="{Binding IsArchived, Converter={StaticResource Show}}"/>
                        </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Choose a game to resolve this link. Earnings stay unchanged." Style="{StaticResource PageDescription}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Recorded date" Style="{StaticResource SessionFieldLabel}"/>
                    <DatePicker Tag="DraftRecordedDate" AutomationProperties.Name="Recorded date" AutomationProperties.HelpText="{Binding RecordedDateError}" SelectedDate="{Binding DraftRecordedDate, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding RecordedDateError}" Style="{StaticResource InlineValidationText}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Posted date" Style="{StaticResource SessionFieldLabel}"/>
                    <DatePicker Tag="DraftPostedDate" AutomationProperties.Name="Posted date" AutomationProperties.HelpText="{Binding PostedDateError}" SelectedDate="{Binding DraftPostedDate, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding PostedDateError}" Style="{StaticResource InlineValidationText}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Duration (minutes)" Style="{StaticResource SessionFieldLabel}"/>
                    <TextBox Tag="DraftDurationMinutes" AutomationProperties.Name="Duration (minutes)" AutomationProperties.HelpText="{Binding DurationError}" Text="{Binding DraftDurationMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModalTextBox}"/>
                    <TextBlock Text="{Binding DurationError}" Style="{StaticResource InlineValidationText}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Earnings (USD)" Style="{StaticResource SessionFieldLabel}"/>
                    <TextBox Tag="DraftEarnings" AutomationProperties.Name="Earnings (USD)" AutomationProperties.HelpText="{Binding EarningsError}" Text="{Binding DraftEarnings, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModalTextBox}"/>
                    <TextBlock Text="{Binding EarningsError}" Style="{StaticResource InlineValidationText}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <TextBlock Text="Status" Style="{StaticResource SessionFieldLabel}"/>
                <ComboBox AutomationProperties.Name="Status" SelectedValuePath="Tag" SelectedValue="{Binding DraftStatus, Mode=TwoWay}">
                    <ComboBoxItem Content="Verified" Tag="{x:Static enums:SessionStatus.Verified}"/>
                    <ComboBoxItem Content="Pending" Tag="{x:Static enums:SessionStatus.Pending}"/>
                    <ComboBoxItem Content="Rejected" Tag="{x:Static enums:SessionStatus.Rejected}"/>
                    <ComboBoxItem Content="Not uploaded" Tag="{x:Static enums:SessionStatus.NotUploaded}"/>
                </ComboBox>
                <CheckBox Content="Force verified" IsChecked="{Binding DraftIsForceVerified, Mode=TwoWay}" Margin="0,12,0,0"/>
                <TextBlock Text="{Binding EditError}" Style="{StaticResource InlineValidationText}" Margin="0,12,0,0"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SessionReadTemplate">
            <StackPanel>
                <Border Style="{StaticResource SessionHistoryStatusBadge}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource SessionHistoryStatusText}"/>
                </Border>
                <TextBlock Text="Force-verified" Foreground="{StaticResource VerifiedTextColor}" Margin="0,8,0,0" Visibility="{Binding Session.IsForceVerified, Converter={StaticResource Show}}"/>
                <TextBlock Text="Recording date / time" Style="{StaticResource SessionFieldLabel}"/>
                <TextBlock Text="{Binding Session.RecordedDate, StringFormat={}{0:MMM d, yyyy h:mm:ss tt}}" TextWrapping="Wrap"/>
                <TextBlock Text="Duration" Style="{StaticResource SessionFieldLabel}"/>
                <TextBlock Text="{Binding Session.DurationText}"/>
                <TextBlock Text="Earnings · USD" Style="{StaticResource SessionFieldLabel}"/>
                <TextBlock Text="{Binding Session.Earnings, StringFormat={}{0:C2}, ConverterCulture=en-US}" Style="{StaticResource SectionHeading}"/>
                <TextBlock Text="Posted date / time" Style="{StaticResource SessionFieldLabel}"/>
                <TextBlock Text="{Binding PostedText}" TextWrapping="Wrap"/>
                <TextBlock Text="Source" Style="{StaticResource SessionFieldLabel}"/>
                <TextBlock Text="{Binding SourceLabel}" TextWrapping="Wrap"/>
                <TextBlock Text="Source ID (linked payout, when recorded)" Style="{StaticResource SessionFieldLabel}"/>
                <TextBlock Text="{Binding SourceId}" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid x:Name="ExplorerRoot" Style="{StaticResource TabMainGrid}">
        <Grid x:Name="BrowseContent">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Sessions" Style="{StaticResource TabName}"/><TextBlock Text="Review recordings, source details and saved corrections." Style="{StaticResource PageDescription}"/></StackPanel>
                <Button Grid.Column="1" Content="Import sessions" Style="{StaticResource PrimaryButton}" Click="ImportSessionsButton_Click" VerticalAlignment="Center"/>
            </Grid>
            <Border x:Name="SessionFilters" Grid.Row="1" Style="{StaticResource SurfacePanel}" Margin="0,0,0,12">
                <WrapPanel>
                    <StackPanel Width="210" Margin="0,0,12,4"><TextBlock Text="Search recordings" Style="{StaticResource ItemSubtitle}" Margin="0,0,0,6"/>
                        <TextBox x:Name="SearchSessionsBox" AutomationProperties.Name="Search by game, source ID or session ID" Style="{StaticResource SearchBar}" Width="Auto" Tag="Game or source ID" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" TextChanged="SearchSessionsBox_TextChanged"/>
                    </StackPanel>
                    <StackPanel Width="144" Margin="0,0,12,4"><TextBlock Text="Verification" Style="{StaticResource ItemSubtitle}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="StatusFilter" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter, Mode=OneWay}" DisplayMemberPath="DisplayText" SelectionChanged="StatusFilter_SelectionChanged" AutomationProperties.Name="Filter by verification"/>
                    </StackPanel>
                    <StackPanel Width="160" Margin="0,0,12,4"><TextBlock Text="Game" Style="{StaticResource ItemSubtitle}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding GameFilters}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedGameFilter, Mode=TwoWay}" AutomationProperties.Name="Filter by game"/>
                    </StackPanel>
                    <StackPanel Width="156" Margin="0,0,12,4"><TextBlock Text="Recording date" Style="{StaticResource ItemSubtitle}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding DateOptions}" SelectedIndex="{Binding SelectedDateIndex, Mode=TwoWay}" AutomationProperties.Name="Filter by recording date"/>
                    </StackPanel>
                    <StackPanel Width="160" Margin="0,0,12,4"><TextBlock Text="Sort" Style="{StaticResource ItemSubtitle}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SelectedSortIndex, Mode=TwoWay}" AutomationProperties.Name="Sort sessions"/>
                    </StackPanel>
                    <Button Content="Clear filters" Style="{StaticResource SecondaryButton}" Click="ClearSessionFilters_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                </WrapPanel>
            </Border>
            <StackPanel Grid.Row="2">
                <TextBlock x:Name="SessionsSummary" Text="{Binding SessionHistoryText}" Style="{StaticResource ItemSubtitle}" Margin="0,0,0,4"/>
                <TextBlock Text="USD · recording-date filters · select a row for details; game links open Game Details" Style="{StaticResource ItemSubtitle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Border x:Name="EditorFeedbackPanel" Style="{StaticResource FeedbackPanel}" Visibility="Collapsed"><DockPanel>
                    <Button x:Name="RetryEditorRefreshButton" Content="Retry refresh" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Click="RetryEditorRefresh_Click" Margin="12,0,0,0"/>
                    <TextBlock x:Name="EditorFeedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </DockPanel></Border>
                <Border x:Name="SessionsLoadPanel" Style="{StaticResource FeedbackPanel}" Visibility="Collapsed"><DockPanel>
                    <Button x:Name="RetrySessionsButton" DockPanel.Dock="Right" Content="Retry" Style="{StaticResource SecondaryButton}" Click="RetrySessions_Click" Margin="12,0,0,0"/>
                    <TextBlock x:Name="SessionsLoadStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </DockPanel></Border>
            </StackPanel>
            <Grid x:Name="Body" Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsGap" Width="0"/><ColumnDefinition x:Name="DetailsColumn" Width="0"/></Grid.ColumnDefinitions>
                <Border x:Name="TableHost" Style="{StaticResource SurfacePanel}" Padding="0">
                    <Grid>
                        <ListView x:Name="SessionsList" ItemsSource="{Binding SessionsView}" SelectionMode="Single" SelectionChanged="SessionsList_SelectionChanged" SizeChanged="Table_SizeChanged"
                            Background="Transparent" BorderThickness="0" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1"
                            AutomationProperties.Name="Sessions table" AutomationProperties.HelpText="Select a row or press Enter to inspect it. The game title opens Game Details independently.">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource TableRow}"><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="{StaticResource FontSizeCompactBody}"/></Style></ListView.ItemContainerStyle>
                            <ListView.View><GridView AllowsColumnReorder="False" ColumnHeaderContainerStyle="{StaticResource TableColumnHeader}">
                                <GridViewColumn x:Name="GameColumn" Header="GAME" Width="190"><GridViewColumn.CellTemplate><DataTemplate>
                                    <Button Content="{Binding Session.GameName}" ToolTip="{Binding Session.GameName}" Style="{StaticResource SessionGameLink}" IsEnabled="{Binding CanNavigate}" Click="GameLink_Click" AutomationProperties.Name="{Binding Session.GameName, StringFormat=Open Game Details for {0}}"/>
                                </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Header="RECORDED" Width="154" DisplayMemberBinding="{Binding Session.RecordedDate, StringFormat={}{0:MMM d, yyyy h:mm tt}}"/>
                                <GridViewColumn Header="DURATION" Width="92" DisplayMemberBinding="{Binding Session.DurationText}"/>
                                <GridViewColumn Header="USD" Width="96"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Session.Earnings, StringFormat={}{0:C2}, ConverterCulture=en-US}" Width="80" TextAlignment="Right" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Header="VERIFICATION" Width="140"><GridViewColumn.CellTemplate><DataTemplate><Border Width="116" Style="{StaticResource SessionHistoryStatusBadge}"><TextBlock Text="{Binding StatusText}" Style="{StaticResource SessionHistoryStatusText}"/></Border></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Header="SOURCE" Width="112" DisplayMemberBinding="{Binding SourceLabel}"/>
                                <GridViewColumn Header="SOURCE ID" Width="120" DisplayMemberBinding="{Binding SourceId}"/>
                            </GridView></ListView.View>
                        </ListView>
                        <StackPanel x:Name="SessionsEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="24" MaxWidth="380">
                            <TextBlock x:Name="SessionsEmptyState" Style="{StaticResource EmptyStateText}" TextWrapping="Wrap"/>
                            <Button x:Name="ClearSessionFiltersButton" Content="Clear filters" Style="{StaticResource SecondaryButton}" Click="ClearSessionFilters_Click" HorizontalAlignment="Center"/>
                            <Button x:Name="EmptyImportSessionsButton" Content="Import sessions" Style="{StaticResource PrimaryButton}" Click="ImportSessionsButton_Click" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="DetailsPanel" Grid.Column="2" Style="{StaticResource SurfacePanel}" Padding="0" Visibility="Collapsed" DataContext="{Binding SelectedSession}" AutomationProperties.Name="Selected session details">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Padding="16" BorderBrush="{StaticResource DefaultBorderColor}" BorderThickness="0,0,0,1"><DockPanel>
                            <Button x:Name="CloseDetailsButton" DockPanel.Dock="Right" Content="×" Style="{StaticResource SecondaryButton}" Click="CloseDetails_Click" Padding="9,3" AutomationProperties.Name="Close session details"/>
                            <StackPanel><TextBlock Text="Session details" Style="{StaticResource SectionHeading}"/><TextBlock Text="{Binding Identifier}" Style="{StaticResource ItemSubtitle}" Margin="0,4,0,0"/></StackPanel>
                        </DockPanel></Border>
                        <ScrollViewer x:Name="DetailsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="16">
                                <Button Content="{Binding Session.GameName}" Style="{StaticResource SessionGameLink}" Click="GameLink_Click" IsEnabled="{Binding CanNavigate}" FontWeight="SemiBold" FontSize="16"/>
                                <StackPanel Visibility="{Binding Visibility, ElementName=SessionsLoadPanel}" Margin="0,8,0,12">
                                    <TextBlock Text="{Binding Text, ElementName=SessionsLoadStatus}" TextWrapping="Wrap" Foreground="{StaticResource PendingTextColor}"/>
                                    <Button Content="Retry snapshot" Click="RetrySessions_Click" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"/>
                                </StackPanel>
                                <Border x:Name="PanelFeedback" Style="{StaticResource FeedbackPanel}" Visibility="Collapsed"><StackPanel>
                                    <TextBlock x:Name="PanelFeedbackText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                    <Button x:Name="PanelRetryButton" Content="Retry refresh" Click="RetryEditorRefresh_Click" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"/>
                                </StackPanel></Border>
                                <ContentControl x:Name="DetailsContent" Content="{Binding}"><ContentControl.Style><Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate" Value="{StaticResource SessionReadTemplate}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource SessionEditorTemplate}"/></DataTrigger></Style.Triggers>
                                </Style></ContentControl.Style></ContentControl>
                                <Expander Header="Source evidence and audit history" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Source IDs are linked payout IDs when recorded. Missing historical evidence remains unknown." Style="{StaticResource PageDescription}"/>
                                        <Expander Header="Linked payout source values" Margin="0,8">
                                            <StackPanel>
                                                <TextBlock Text="Raw payout source row (when recorded)" Style="{StaticResource SessionFieldLabel}"/>
                                                <TextBox Text="{Binding Session.Payout.SourceRow, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModalTextBox}"/>
                                                <TextBlock Text="Original payout values (when recorded)" Style="{StaticResource SessionFieldLabel}"/>
                                                <TextBox Text="{Binding Session.Payout.SourceValuesJson, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModalTextBox}"/>
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock x:Name="EvidenceStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0"/>
                                        <Button Content="Retry evidence" Click="RetryEvidence_Click" Style="{StaticResource SecondaryButton}" Margin="0,8"/>
                                        <ListBox ItemsSource="{Binding Evidence}" MaxHeight="280" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Background="Transparent" BorderThickness="0">
                                            <ListBox.ItemTemplate><DataTemplate><Expander Margin="0,8">
                                                <Expander.Header><StackPanel><TextBlock Text="{Binding ChangeType}"/><TextBlock Text="{Binding ChangedAt, StringFormat={}{0:MMM d, yyyy h:mm:ss tt}}" Style="{StaticResource ItemSubtitle}"/></StackPanel></Expander.Header>
                                                <StackPanel><TextBlock Text="Raw source (when recorded)" Style="{StaticResource SessionFieldLabel}"/>
                                                    <TextBox Text="{Binding SourceText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModalTextBox}"/>
                                                    <TextBlock Text="Before" Style="{StaticResource SessionFieldLabel}"/><TextBox Text="{Binding BeforeValuesJson, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModalTextBox}"/>
                                                    <TextBlock Text="After / original imported values" Style="{StaticResource SessionFieldLabel}"/><TextBox Text="{Binding AfterValuesJson, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModalTextBox}"/>
                                                </StackPanel>
                                            </Expander></DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2" Padding="16" BorderBrush="{StaticResource DefaultBorderColor}" BorderThickness="0,1,0,0">
                            <Grid>
                                <StackPanel x:Name="ReadActions" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Delete" Style="{StaticResource SecondaryButton}" Click="DeleteSessionButton_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="EditSessionButton" Content="Edit session" Style="{StaticResource PrimaryButton}" Click="EditSessionButton_Click"/>
                                </StackPanel>
                                <StackPanel x:Name="EditActions" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="CancelSessionEditButton_Click" Margin="0,0,8,0"/>
                                    <Button Content="Save changes" Style="{StaticResource PrimaryButton}" Click="SaveSessionButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Grid x:Name="DrawerLayer" Background="#99000000" Visibility="Collapsed" MouseLeftButtonDown="Scrim_MouseLeftButtonDown"/>
    </Grid>
</UserControl>
