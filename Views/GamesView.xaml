<UserControl x:Class="EarningsTracker.Views.GamesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:EarningsTracker.Views"
    xmlns:models="clr-namespace:EarningsTracker.Models"
    xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    x:Name="Root" SizeChanged="View_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="OwnershipButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSupporting}"/>
            <Setter Property="MinWidth" Value="120"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOwned}" Value="True">
                    <Setter Property="Background" Value="{StaticResource VerifiedBackgroundColor}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource VerifiedTextColor}"/>
                    <Setter Property="Foreground" Value="{StaticResource VerifiedTextColor}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <BooleanToVisibilityConverter x:Key="Show"/>
        <Style x:Key="GamesFilterLabel" TargetType="TextBlock" BasedOn="{StaticResource ItemSubtitle}"><Setter Property="Margin" Value="0,0,0,6"/></Style>
        <Style x:Key="GameTitleLink" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{StaticResource AccentTextColor}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource SectionHeading}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource AccentTextColor}"/></DataTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GameArtwork" TargetType="ContentControl" BasedOn="{StaticResource ArtworkPresenter}">
            <Style.Triggers><Trigger Property="Content" Value="{x:Null}">
                <Setter Property="AutomationProperties.Name" Value="Artwork unavailable"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
                    <Border BorderBrush="{StaticResource DefaultBorderColor}" BorderThickness="1" CornerRadius="6" Padding="4">
                        <TextBlock Text="No&#10;artwork" Style="{StaticResource ItemSubtitle}" TextAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate></Setter.Value></Setter>
            </Trigger></Style.Triggers>
        </Style>
        <Style x:Key="GamePassEvidence" TargetType="TextBlock" BasedOn="{StaticResource PageDescription}">
            <Setter Property="Margin" Value="0,8,0,0"/><Setter Property="Foreground" Value="{StaticResource SecondaryTextColor}"/>
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding GamePassStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding GamePassCurrentlyAvailable}" Value="True"><Setter Property="Foreground" Value="{StaticResource VerifiedTextColor}"/></DataTrigger>
                <DataTrigger Binding="{Binding GamePassNeedsVerification}" Value="True"><Setter Property="Foreground" Value="{StaticResource PendingTextColor}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Style="{StaticResource TabMainGrid}">
        <Grid x:Name="GamesListView">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Games" Style="{StaticResource TabName}"/><TextBlock Text="Browse earning opportunities and your game library." Style="{StaticResource PageDescription}"/></StackPanel>
                <Button Grid.Column="1" Content="Starting view…" ToolTip="Open Settings to save the starting sort, bookmark and archived preferences" Style="{StaticResource SecondaryButton}" Click="CatalogSettings_Click" VerticalAlignment="Center"/>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource SurfacePanel}" Margin="0,0,0,12">
                <StackPanel>
                    <WrapPanel x:Name="GamesToolbar">
                        <StackPanel Width="236" Margin="0,0,12,8"><TextBlock Text="Find a game" Style="{StaticResource GamesFilterLabel}"/>
                            <TextBox x:Name="SearchBox" AutomationProperties.Name="Search games" Style="{StaticResource SearchBar}" Width="Auto" Tag="Search your game library" TextChanged="SearchBox_TextChanged"/>
                        </StackPanel>
                        <StackPanel Width="156" Margin="0,0,12,8"><TextBlock Text="Sort" Style="{StaticResource GamesFilterLabel}"/>
                            <ComboBox x:Name="SortComboBox" AutomationProperties.Name="Sort games" SelectionChanged="SortComboBox_SelectionChanged">
                                <ComboBoxItem Content="Highest Pay"/><ComboBoxItem Content="Game A-Z"/><ComboBoxItem Content="Newest"/><ComboBoxItem Content="Lowest price"/>
                            </ComboBox>
                        </StackPanel>
                        <Button Content="Clear filters" Style="{StaticResource SecondaryButton}" Click="ClearFilters_Click" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="Genre" Style="{StaticResource GamesFilterLabel}"/>
                            <ComboBox x:Name="GenreFilter" AutomationProperties.Name="Filter games by genre" ItemsSource="{Binding GenreOptions}" SelectedItem="{Binding SelectedGenre, Mode=TwoWay}" IsTextSearchEnabled="True"/>
                        </StackPanel>
                        <StackPanel Width="156" Margin="0,0,12,8"><TextBlock Text="Store" Style="{StaticResource GamesFilterLabel}"/>
                            <ComboBox AutomationProperties.Name="Filter games by store" ItemsSource="{Binding StoreOptions}" SelectedItem="{Binding SelectedStore, Mode=TwoWay}"/>
                        </StackPanel>
                        <CheckBox x:Name="BookmarkFilter" Content="Bookmarks only" IsChecked="{Binding BookmarkedOnly, Mode=OneWay}" Checked="BookmarkFilter_Checked" Unchecked="BookmarkFilter_Unchecked" Margin="0,20,12,8"/>
                        <CheckBox Content="Show archived" IsChecked="{Binding ShowArchived, Mode=TwoWay}" Margin="0,20,0,8"/>
                    </WrapPanel>
                    <WrapPanel>
                        <CheckBox Content="Free-to-play" IsChecked="{Binding FreeOnly}" Margin="0,0,12,8"/>
                        <CheckBox Content="Owned" IsChecked="{Binding OwnedOnly}" Margin="0,0,12,8"/>
                        <CheckBox Content="PC Game Pass" IsChecked="{Binding GamePassOnly}" ToolTip="{Binding GamePassFilterHelp}" Margin="0,0,12,8"/>
                        <CheckBox Content="Playable now" IsChecked="{Binding PlayableOnly}" Margin="0,0,12,8"/>
                    </WrapPanel>
                    <TextBlock Text="Includes stale evidence; only current availability grants subscription-based Playable now." Style="{StaticResource PageDescription}" Visibility="{Binding GamePassOnly, Converter={StaticResource Show}}"/>
                    <TextBlock Text="{Binding PriceSortHelp}" Style="{StaticResource PageDescription}" Visibility="{Binding ShowPriceSortHelp, Converter={StaticResource Show}}"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <DockPanel><Button x:Name="RefreshCatalogButton" DockPanel.Dock="Right" Content="Refresh catalog" Style="{StaticResource SecondaryButton}" Click="RefreshCatalog_Click" Margin="12,0,0,0"/>
                    <StackPanel><TextBlock Text="{Binding AvailableGamesText}" Style="{StaticResource ItemSubtitle}"/>
                        <TextBlock Text="{Binding CatalogStatus}" Style="{StaticResource ItemSubtitle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding BookmarkError}" Style="{StaticResource InlineValidationText}"/>
            </StackPanel>
            <ListBox x:Name="GamesList" Grid.Row="3" ItemsSource="{Binding GamesView}" ItemContainerStyle="{StaticResource GameCardItem}" Background="Transparent" BorderThickness="0"
                PreviewMouseLeftButtonDown="GamesList_PreviewMouseLeftButtonDown" KeyDown="GamesList_KeyDown"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1" VirtualizingPanel.CacheLengthUnit="Page"
                ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                AutomationProperties.Name="Game library" AutomationProperties.HelpText="Select a row, then press Enter or open its title for Game Details. Ownership and bookmarks are separate actions.">
                <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate><DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.RowSpan="2" Width="60" Height="80" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource SurfaceColor}" CornerRadius="6" ClipToBounds="True">
                            <ContentControl Style="{StaticResource GameArtwork}" Content="{Binding Cover}"/>
                        </Border>
                        <StackPanel x:Name="Title" Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource TransactionBadge}" Background="{StaticResource ArchivedBackgroundColor}" Margin="8,0,0,0" Visibility="{Binding Game.IsArchived, Converter={StaticResource Show}}">
                                    <TextBlock Text="Archived" Foreground="{StaticResource ArchivedTextColor}" FontSize="{StaticResource FontSizeSupporting}"/>
                                </Border>
                                <Button Content="{Binding Game.Name}" ToolTip="{Binding Game.Name}" Style="{StaticResource GameTitleLink}" Click="GameTitle_Click" AutomationProperties.Name="{Binding Game.Name, StringFormat=Open Game Details for {0}}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding GenreText}" Style="{StaticResource ItemSubtitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding GenreText}" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Command="{Binding ToggleOwnedCommand}" Content="{Binding OwnershipButtonText}" Style="{StaticResource OwnershipButton}" ToolTip="{Binding OwnershipTooltip}" AutomationProperties.Name="{Binding OwnershipButtonText}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SourceText}" Style="{StaticResource ItemSubtitle}" TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding OwnershipError}" Style="{StaticResource InlineValidationText}"/>
                        </StackPanel>
                        <Grid x:Name="Comparisons" Grid.Column="2" Width="596" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="152"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="3" Background="{StaticResource InputBackgroundColor}" CornerRadius="6" Margin="-6,-4,12,-4"/>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Rate · USD/h" Style="{StaticResource ItemSubtitle}"/>
                                <TextBlock Text="{Binding Game.RatePerHour, StringFormat={}{0:C2}, ConverterCulture=en-US}" Style="{StaticResource SectionHeading}" Margin="0,6,0,4"/><TextBlock Text="{Binding RateBasis}" Style="{StaticResource ItemSubtitle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Cycle cap" Style="{StaticResource ItemSubtitle}"/><TextBlock Text="{Binding CycleCapText}" FontWeight="SemiBold" Margin="0,6,0,4"/>
                                <TextBlock Text="Full cycle" Style="{StaticResource ItemSubtitle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,16,0"><TextBlock Text="Full-cycle potential" Style="{StaticResource ItemSubtitle}"/><TextBlock Text="{Binding PotentialText}" Style="{StaticResource SectionHeading}" Margin="0,6,0,4"/><TextBlock Text="{Binding PotentialBasis}" Style="{StaticResource ItemSubtitle}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="{Binding PriceText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding PriceTooltip}"/><TextBlock Text="{Binding PriceEvidence}" Style="{StaticResource PageDescription}"/></StackPanel>
                        </Grid>
                        <Button Grid.Column="3" Command="{Binding ToggleBookmarkCommand}" Style="{StaticResource BookmarkButton}" VerticalAlignment="Top" ToolTip="Toggle bookmark" AutomationProperties.Name="{Binding Game.Name, StringFormat=Toggle bookmark for {0}}">
                            <fluent:FluentIcon Icon="Bookmark" IconSize="Size20" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"><fluent:FluentIcon.Style><Style TargetType="fluent:FluentIcon"><Setter Property="IconVariant" Value="Regular"/><Style.Triggers><DataTrigger Binding="{Binding IsBookmarked}" Value="True"><Setter Property="IconVariant" Value="Filled"/></DataTrigger></Style.Triggers></Style></fluent:FluentIcon.Style></fluent:FluentIcon>
                        </Button>
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding GamePassStatus}" Style="{StaticResource GamePassEvidence}"/>
                    </Grid>
                    <DataTemplate.Triggers><DataTrigger Binding="{Binding IsCompactLibrary, RelativeSource={RelativeSource AncestorType=local:GamesView}}" Value="True">
                        <Setter TargetName="Title" Property="Grid.ColumnSpan" Value="2"/>
                        <Setter TargetName="Comparisons" Property="Grid.Row" Value="1"/><Setter TargetName="Comparisons" Property="Grid.Column" Value="1"/><Setter TargetName="Comparisons" Property="Grid.ColumnSpan" Value="2"/>
                        <Setter TargetName="Comparisons" Property="Width" Value="Auto"/><Setter TargetName="Comparisons" Property="Margin" Value="0,12,0,0"/>
                    </DataTrigger></DataTemplate.Triggers>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="GamesEmptyState" Grid.Row="3" Text="{Binding EmptyStateText}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowEmptyState}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
        <Grid x:Name="GameDetailsView" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Button x:Name="DetailsBackButton" AutomationProperties.Name="Back to games" Grid.Row="0" Click="GameDetailsBackButton_Click" HorizontalAlignment="Left" Style="{StaticResource LinkButtonStyle}" Margin="0,0,0,12">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <fluent:FluentIcon
                        Grid.Column="0"
                        Icon="ArrowPrevious"
                        Foreground="{StaticResource SecondaryTextColor}"
                        Margin="0,0,0,0"/>

                            <TextBlock
                        Grid.Column="1"
                        Text="Library"
                        VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextColor}" FontSize="{StaticResource FontSizeSupporting}" FontWeight="SemiBold"/>
                        </Grid>
            </Button>
          <!-- The header is the first item on the same finite, pixel-scrolling virtualized surface. -->
          <ListBox Grid.Row="1" x:Name="GameSessionsList" Background="Transparent" BorderThickness="0"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                   VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ItemButton}">
                    <Setter Property="Margin" Value="0,0,12,0"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource DefaultBorderColor}"/>
                    <Setter Property="BorderThickness" Value="1,0,1,1"/>
                    <Setter Property="Template"><Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="SessionRowSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SessionRowSurface" Property="Background" Value="{StaticResource CardBackgroundColor}"/></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="SessionRowSurface" Property="Background" Value="{StaticResource AccentBackgroundColor}"/></Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SessionRowSurface" Property="BorderBrush" Value="{StaticResource AccentColor}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value></Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource VerticalScrollBar}"/>
                <DataTemplate DataType="{x:Type models:Session}">
                    <Grid Margin="0 0 10 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding DateTimeText}" Style="{StaticResource GameSessionDetailsStyle}"/>
                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource GameSessionDetailsStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EarningsText}" Style="{StaticResource SectionHeading}" HorizontalAlignment="Right"/>
                            <Border Style="{StaticResource DetailedSessionStatusBadge}" Margin="0,8,0,0" HorizontalAlignment="Right">
                                <TextBlock Style="{StaticResource DetailedSessionStatusText}" FontSize="{StaticResource FontSizeSupporting}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.Resources>
            <ListBox.ItemsSource>
              <CompositeCollection>
                <ListBoxItem Focusable="False" IsTabStop="False" Padding="0" Margin="0" HorizontalContentAlignment="Stretch">
                  <ListBoxItem.Template>
                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                  </ListBoxItem.Template>
                   <Grid Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>

            <!--Game Header-->
            <Border Grid.Row="1" Style="{StaticResource GameDetailPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="60" Height="80" Background="{StaticResource ArchivedBackgroundColor}" Margin="0,0,12,0">
                            <ContentControl Style="{StaticResource GameArtwork}" Content="{Binding Catalog.Cover}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Game.Name}" Style="{StaticResource TabName}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Catalog.RateBasis}" Style="{StaticResource PageDescription}"/>
                            <TextBlock Text="Archived identity · history and stored rate retained" Foreground="{StaticResource ArchivedTextColor}" TextWrapping="Wrap" Visibility="{Binding Game.IsArchived, Converter={StaticResource Show}}"/>
                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding Game.RatePerHour, StringFormat={}{0:C2}/hr, ConverterCulture=en-US}" Style="{StaticResource SectionHeading}" Margin="0,0,16,4"/>
                                <TextBlock Text="{Binding Game.MinutesCap, StringFormat={}{0:0.##} min cap}" Style="{StaticResource ItemSubtitle}" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </StackPanel>
                        <Button Grid.Column="2" DataContext="{Binding Catalog}" Command="{Binding ToggleBookmarkCommand}" Style="{StaticResource BookmarkButton}" Margin="8,0,0,0" AutomationProperties.Name="Toggle game bookmark" ToolTip="Toggle bookmark">
                            <fluent:FluentIcon Icon="Bookmark" IconSize="Size20" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <fluent:FluentIcon.Style><Style TargetType="fluent:FluentIcon">
                                    <Setter Property="IconVariant" Value="Regular"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsBookmarked}" Value="True"><Setter Property="IconVariant" Value="Filled"/></DataTrigger></Style.Triggers>
                                </Style></fluent:FluentIcon.Style>
                            </fluent:FluentIcon>
                        </Button>
                    </Grid>

                </Grid>
            </Border>

            <Grid x:Name="DetailColumns" Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel x:Name="DetailLeft">
                    <TextBlock Text="Earnings &amp; cap" Style="{StaticResource SectionHeading}" Margin="0,12,0,8"/>
                    <TextBlock Style="{StaticResource PageDescription}"><Run Text="Full-cycle potential: "/><Run Text="{Binding Catalog.PotentialText, Mode=OneWay}"/></TextBlock>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!--Game Progress-->
                <Border Grid.Column="0" Style="{StaticResource GameDetailPanel}" Margin="0 4 4 4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource GameDetailPanelLabel}" Text="Verified play time"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource GameDetailPanelValue}" Text="{Binding TotalDurationText}"/>
                        <ProgressBar Grid.Row="2" Style="{StaticResource MetricProgressBar}" Value="{Binding ProgressPercentage, Mode=OneWay}" Margin="0,4,0,12" AutomationProperties.Name="Verified minute cap utilization"/>
                        <TextBlock Grid.Row="3" Style="{StaticResource GameDetailPanelDescription}" Text="{Binding MinutesDescription}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="4" Style="{StaticResource GameDetailPanelDescription}" Text="{Binding ProgressDescription}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </Grid>
                </Border>
                <!--Earning Potential-->
                <Border Grid.Column="1" Style="{StaticResource GameDetailPanel}" Margin="4 4 0 4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource GameDetailPanelLabel}" Text="Verified earnings"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource GameDetailPanelValue}" Text="{Binding TotalEarnings, StringFormat={}{0:C2}, ConverterCulture=en-US}"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource GameDetailPanelDescription}" Text="{Binding EarningsDescription}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
                <!--TODO: Average session duration-->
            </Grid>
            <Border Style="{StaticResource SurfacePanel}" Margin="0,8">
                <WrapPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,8">
                        <TextBlock Text="Cap reset date" Style="{StaticResource GameDetailPanelLabel}"/>
                        <TextBlock Text="No date uses all verified sessions" Style="{StaticResource GameDetailPanelDescription}"/>
                    </StackPanel>
                    <DatePicker AutomationProperties.Name="Cap reset date" x:Name="CapResetDatePicker" SelectedDate="{Binding Game.CapResetDate, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <Button Content="Save reset date" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Click="SaveCapResetDateButton_Click"/>
                </WrapPanel>
            </Border>
                    <Border Style="{StaticResource SurfacePanel}" Margin="0,0,0,12"><StackPanel>
                        <TextBlock Text="Personal ownership" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Text="{Binding Catalog.PurchaseEvidence}" Style="{StaticResource PageDescription}"/>
                        <TextBlock Text="{Binding Catalog.BreakEvenText}" Style="{StaticResource PageDescription}"/>
                        <Button Content="Ownership / purchase cost" Style="{StaticResource SecondaryButton}" Click="Ownership_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource SurfacePanel}" Margin="0,0,0,12"><StackPanel>
                        <TextBlock Text="Steam · not connected" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Text="Ownership: placeholder only · Installation: placeholder only. Personal ownership works without Steam. No account or local library is read." Style="{StaticResource PageDescription}"/>
                    </StackPanel></Border>
                </StackPanel>
                <StackPanel x:Name="DetailRight" Grid.Column="2">
                    <Border Style="{StaticResource SurfacePanel}" Margin="0,12,0,12"><StackPanel x:Name="CatalogDetailsPanel">
                        <TextBlock Text="Acquisition &amp; editions" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Text="{Binding Catalog.GenreText}" Style="{StaticResource PageDescription}"/>
                        <TextBlock Text="{Binding Catalog.Summary}" Style="{StaticResource PageDescription}"/>
                        <TextBlock Text="{Binding Catalog.AccessStatusText}" Style="{StaticResource PageDescription}"/>
                        <ItemsControl ItemsSource="{Binding Catalog.OfferDetails}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Button Style="{StaticResource LinkButtonStyle}" Click="OpenCatalogLink_Click" Tag="{Binding Url}" ToolTip="{Binding Tooltip}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,12,0,0">
                                <StackPanel><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Details}" Style="{StaticResource PageDescription}"/></StackPanel>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="Subscription evidence" Style="{StaticResource SectionHeading}" Margin="0,16,0,0"/>
                        <ItemsControl ItemsSource="{Binding Catalog.SubscriptionDetails}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Button Style="{StaticResource LinkButtonStyle}" Click="OpenCatalogLink_Click" Tag="{Binding Url}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,12,0,0">
                                <StackPanel><TextBlock Text="{Binding Text}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource DefaultTextColor}"/><Style.Triggers><DataTrigger Binding="{Binding IsWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource PendingTextColor}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Details}" Style="{StaticResource PageDescription}"/></StackPanel>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Expander x:Name="CatalogProvenance" Header="Catalog source &amp; verification" Margin="0,16,0,0">
                            <Expander.Style><Style TargetType="Expander"><Setter Property="IsExpanded" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding Catalog.Metadata.Reviewed}" Value="True"><Setter Property="IsExpanded" Value="False"/></DataTrigger></Style.Triggers></Style></Expander.Style>
                            <TextBlock Text="{Binding Catalog.MetadataStatus}" Style="{StaticResource PageDescription}"/>
                        </Expander>
                    </StackPanel></Border>
                    <Expander Header="Rate identities and cap-reset history" Margin="0,0,0,12"><StackPanel>
                        <TextBlock Text="{Binding HistoryEvidenceText}" Style="{StaticResource PageDescription}"/>
                        <ListBox ItemsSource="{Binding RateIdentities}" MaxHeight="180" Background="Transparent" BorderThickness="0" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate>
                            <TextBlock TextWrapping="Wrap"><Run Text="{Binding Name}"/><Run Text=" · #"/><Run Text="{Binding Id}"/><Run Text=" · "/><Run Text="{Binding RatePerHour, StringFormat={}{0:C2}/hr, ConverterCulture=en-US}"/><Run Text=" · "/><Run Text="{Binding MinutesCap}"/><Run Text=" min cap · archived: "/><Run Text="{Binding IsArchived}"/></TextBlock>
                        </DataTemplate></ListBox.ItemTemplate></ListBox>
                        <ListBox ItemsSource="{Binding CapResetHistory}" MaxHeight="240" Background="Transparent" BorderThickness="0" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><Expander Margin="0,8">
                            <Expander.Header><TextBlock Text="{Binding ChangedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/></Expander.Header>
                            <StackPanel><TextBlock Text="{Binding ChangeType}"/><TextBox Text="{Binding BeforeValuesJson, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ModalTextBox}" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto"/><TextBox Text="{Binding AfterValuesJson, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ModalTextBox}" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto"/></StackPanel>
                        </Expander></DataTemplate></ListBox.ItemTemplate></ListBox>
                    </StackPanel></Expander>
                </StackPanel>
            </Grid>
            <!--Add Session-->
            <StackPanel Grid.Row="4" Margin="0,8">
                <TextBlock Text="{Binding BookmarkError}" DataContext="{Binding DataContext, ElementName=Root}" Style="{StaticResource InlineValidationText}" Margin="0,0,0,8"/>
                <!-- Game Details import is deferred beyond v1.0.0; retain the implementation. -->
                <Button x:Name="AddSessionButton" Visibility="Collapsed" Content="Add Session" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="AddSessionButton_Click"/>
            </StackPanel>
            <!--Sessions-->
            <Border Grid.Row="5" Style="{StaticResource SurfacePanel}" CornerRadius="8,8,0,0" Margin="0 4 0 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeading}" Text="{Binding FilteredSessionString}"/>
                    <ItemsControl x:Name="SessionFilterList" Grid.Row="1" ItemsSource="{Binding StatusFilters}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <RadioButton Content="{Binding DisplayText}" GroupName="GameDetailStatusFilters" IsChecked="{Binding IsSelected, Mode=OneWay}" Style="{StaticResource SessionFilterChip}" Checked="DetailSessionFilter_Checked"/>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="2" Text="{Binding SessionEmptyText}" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
           </Grid>
                </ListBoxItem>
                <CollectionContainer x:Name="SessionRowsCollection"/>
              </CompositeCollection>
            </ListBox.ItemsSource>
          </ListBox>
        </Grid>
    </Grid>
</UserControl>
