<UserControl x:Class="EarningsTracker.Views.GamesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:EarningsTracker.Views"
    xmlns:models="clr-namespace:EarningsTracker.Models"
    xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    x:Name="Root" SizeChanged="View_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="OwnershipButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSupporting}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOwned}" Value="True">
                    <Setter Property="Background" Value="{StaticResource VerifiedBackgroundColor}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource VerifiedTextColor}"/>
                    <Setter Property="Foreground" Value="{StaticResource VerifiedTextColor}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSteamOwned}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <BooleanToVisibilityConverter x:Key="Show"/>
        <Style x:Key="GameTitleLink" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{StaticResource AccentTextColor}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource SectionHeading}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource AccentTextColor}"/></DataTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GameArtwork" TargetType="ContentControl" BasedOn="{StaticResource ArtworkPresenter}">
            <Style.Triggers><Trigger Property="Content" Value="{x:Null}">
                <Setter Property="AutomationProperties.Name" Value="Artwork unavailable"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
                    <Border BorderBrush="{StaticResource DefaultBorderColor}" BorderThickness="1" CornerRadius="6" Padding="4">
                        <TextBlock Text="No&#10;artwork" FontSize="{StaticResource FontSizeSupporting}" Style="{StaticResource ItemSubtitle}" TextAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate></Setter.Value></Setter>
            </Trigger></Style.Triggers>
        </Style>
        <Style x:Key="GamePassEvidence" TargetType="TextBlock" BasedOn="{StaticResource PageDescription}">
            <Setter Property="Margin" Value="0,8,0,0"/><Setter Property="Foreground" Value="{StaticResource SecondaryTextColor}"/>
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding GamePassStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding GamePassCurrentlyAvailable}" Value="True"><Setter Property="Foreground" Value="{StaticResource VerifiedTextColor}"/></DataTrigger>
                <DataTrigger Binding="{Binding GamePassNeedsVerification}" Value="True"><Setter Property="Foreground" Value="{StaticResource PendingTextColor}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Style="{StaticResource TabMainGrid}">
        <Grid x:Name="GamesListView">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Games" Style="{StaticResource TabName}"/></StackPanel>
                <Button Grid.Column="1" Content="Starting view…" Visibility="Collapsed" ToolTip="Open Settings to save the starting sort, bookmark and archived preferences" Style="{StaticResource SecondaryButton}" Click="CatalogSettings_Click" VerticalAlignment="Center"/>
            </Grid>
            <Border x:Name="FilterToolbar" Grid.Row="1" Margin="0,0,0,4">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" AutomationProperties.Name="Search games" Style="{StaticResource FilterSearchBox}"
                                 Margin="0,0,12,0" Tag="Search games…" TextChanged="SearchBox_TextChanged"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                            <TextBlock Text="Sort" Style="{StaticResource ItemSubtitle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="SortComboBox" Style="{StaticResource FilterDropdown}" Width="178" AutomationProperties.Name="Sort games" SelectionChanged="SortComboBox_SelectionChanged">
                                <ComboBoxItem Content="Highest hourly rate"/><ComboBoxItem Content="Name A–Z"/><ComboBoxItem Content="Newest added"/><ComboBoxItem Content="Lowest saved price"/>
                            </ComboBox>
                        </StackPanel>
                        <Button x:Name="ClearFiltersButton" Grid.Column="2" Content="Clear filters" Style="{StaticResource FilterToolbarButton}" IsEnabled="{Binding CanClearFilters}" Click="ClearFilters_Click"
                                ToolTip="Clear search and filters; keep sorting and Show archived."/>
                    </Grid>
                    <WrapPanel x:Name="GamesToolbar">
                        <CheckBox Content="Playable now" IsChecked="{Binding PlayableOnly}" Style="{StaticResource FilterCheckBox}"/>
                        <CheckBox Content="Owned" IsChecked="{Binding OwnedOnly}" Style="{StaticResource FilterCheckBox}"/>
                        <CheckBox x:Name="BookmarkFilter" Content="Bookmarked" IsChecked="{Binding BookmarkedOnly, Mode=TwoWay}" Style="{StaticResource FilterCheckBox}"/>
                        <CheckBox x:Name="MultiplayerFilter" Content="Multiplayer" IsChecked="{Binding MultiplayerOnly}" Style="{StaticResource FilterCheckBox}"
                                  ToolTip="Recorded multiplayer or co-op support, including local modes. Unknown games are excluded. Check the store for player counts, online/local modes and current server availability."
                                  AutomationProperties.Name="Filter multiplayer games"/>
                        <ComboBox x:Name="GenreFilter" Style="{StaticResource SearchableFilterDropdown}" Width="160" Margin="0,0,8,8"
                                  AutomationProperties.Name="Filter games by genre" ToolTip="{Binding SelectedGenre, StringFormat=Genre: {0}}" ItemsSource="{Binding GenreOptions}" SelectedItem="{Binding SelectedGenre, Mode=TwoWay}"/>
                        <ComboBox x:Name="StoreFilter" Style="{StaticResource ActiveFilterDropdown}" Width="150" Margin="0,0,8,8"
                                  AutomationProperties.Name="Filter games by store" ToolTip="{Binding SelectedStore, StringFormat=Store: {0}}" ItemsSource="{Binding StoreOptions}" SelectedItem="{Binding SelectedStore, Mode=TwoWay}"/>
                        <Button x:Name="MoreFiltersButton" Click="MoreFilters_Click" Margin="0,0,0,8" AutomationProperties.Name="{Binding MoreFiltersText}"
                                AutomationProperties.HelpText="Opens secondary filters. Escape closes the popover.">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilterToolbarButton}">
                                <Setter Property="Background" Value="{StaticResource AccentBackgroundColor}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding SecondaryFilterCount}" Value="0">
                                    <Setter Property="Background" Value="{StaticResource ControlBackgroundColor}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource ControlBorderColor}"/>
                                </DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding MoreFiltersText}" VerticalAlignment="Center"/>
                                <fluent:FluentIcon Icon="ChevronDown" IconSize="Size16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <Popup x:Name="MoreFiltersPopup" PlacementTarget="{Binding ElementName=MoreFiltersButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Opened="MoreFiltersPopup_Opened">
                        <Border Background="{StaticResource DialogBackgroundColor}" BorderBrush="{StaticResource DefaultBorderColor}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="12"
                                DataContext="{Binding PlacementTarget.DataContext, ElementName=MoreFiltersPopup}">
                            <StackPanel x:Name="MoreFiltersPanel" Width="280" KeyboardNavigation.TabNavigation="Cycle" KeyDown="MoreFilters_KeyDown">
                                <TextBlock Text="More filters" Style="{StaticResource SectionHeading}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="FreeFilter" Content="Free-to-play" IsChecked="{Binding FreeOnly}" Style="{StaticResource FilterCheckBox}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="SteamFilter" Content="Steam owned" IsChecked="{Binding SteamOnly}" Style="{StaticResource FilterCheckBox}" Margin="0,0,0,8" ToolTip="Matching games in your last synced Steam library. Link or sync your account in Settings."/>
                                <CheckBox x:Name="GamePassFilter" Content="PC Game Pass" IsChecked="{Binding GamePassOnly}" Style="{StaticResource FilterCheckBox}" Margin="0,0,0,8" ToolTip="{Binding GamePassFilterHelp}"/>
                                <CheckBox x:Name="ArchivedFilter" Content="Show archived" IsChecked="{Binding ShowArchived, Mode=TwoWay}" Style="{StaticResource FilterCheckBox}" Margin="0"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <TextBlock Text="Includes previously listed games. Check current availability." Style="{StaticResource PageDescription}" Visibility="{Binding GamePassOnly, Converter={StaticResource Show}}"/>
                    <StackPanel Visibility="{Binding ShowPriceSortHelp, Converter={StaticResource Show}}">
                        <TextBlock Text="{Binding PriceSortHelp}" Style="{StaticResource PageDescription}"/>
                        <Expander Header="Price comparison details" Margin="0,4,0,8"><TextBlock Text="Compares saved PH purchase and active free/giveaway offers using saved PHP exchange rates, within active/archived groups. Unknown prices or missing exchange rates sort last. Check editions and price dates in game details." Style="{StaticResource PageDescription}" TextWrapping="Wrap" Margin="0,8,0,0"/></Expander>
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <DockPanel><Button x:Name="RefreshCatalogButton" DockPanel.Dock="Right" Content="Refresh catalog" Style="{StaticResource SecondaryButton}" Click="RefreshCatalog_Click" Margin="12,0,0,0"/>
                    <StackPanel><TextBlock Text="{Binding AvailableGamesText}" Style="{StaticResource ItemSubtitle}" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="{Binding CatalogStatus}" Style="{StaticResource ItemSubtitle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding SteamStatus}" Style="{StaticResource ItemSubtitle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="BookmarkErrorText" Text="{Binding BookmarkError}" Style="{StaticResource InlineValidationText}"/>
            </StackPanel>
            <ListBox x:Name="GamesList" Grid.Row="3" ItemsSource="{Binding GamesView}" Background="Transparent" BorderThickness="0"
                PreviewMouseLeftButtonDown="GamesList_PreviewMouseLeftButtonDown" KeyDown="GamesList_KeyDown"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1" VirtualizingPanel.CacheLengthUnit="Page"
                ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                AutomationProperties.Name="Game library" AutomationProperties.HelpText="Select a row, then press Enter or open its title for Game Details. Ownership and bookmarks are separate actions.">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource GameCardItem}">
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate><DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border x:Name="Artwork" Width="48" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource SurfaceColor}" CornerRadius="6" ClipToBounds="True">
                            <ContentControl Style="{StaticResource GameArtwork}" Content="{Binding Cover}"/>
                        </Border>
                        <StackPanel x:Name="Title" Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource TransactionBadge}" Background="{StaticResource ArchivedBackgroundColor}" Margin="8,0,0,0" Visibility="{Binding Game.IsArchived, Converter={StaticResource Show}}">
                                    <TextBlock Text="Archived" Foreground="{StaticResource ArchivedTextColor}" FontSize="{StaticResource FontSizeSupporting}"/>
                                </Border>
                                <Button Content="{Binding Game.Name}" ToolTip="{Binding Game.Name}" Style="{StaticResource GameTitleLink}" Click="GameTitle_Click" AutomationProperties.Name="{Binding Game.Name, StringFormat=Open Game Details for {0}}"/>
                            </DockPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <TextBlock Text="{Binding GenreText}" Style="{StaticResource ItemSubtitle}" TextTrimming="CharacterEllipsis" MaxWidth="180" ToolTip="{Binding GenreText}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Button Command="{Binding ToggleOwnedCommand}" Content="{Binding OwnershipButtonText}" Style="{StaticResource OwnershipButton}" ToolTip="{Binding OwnershipTooltip}" AutomationProperties.Name="{Binding OwnershipAccessibleName}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SourceText}" Style="{StaticResource ItemSubtitle}" TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding OwnershipError}" Style="{StaticResource InlineValidationText}"/>
                        </StackPanel>
                        <Grid x:Name="Comparisons" Grid.Column="2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.65*"/><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Rate" Style="{StaticResource ItemSubtitle}" TextAlignment="Right"/>
                                <TextBlock Text="{Binding Game.RatePerHour, StringFormat={}{0:C2}/h, ConverterCulture=en-US}" FontSize="{StaticResource FontSizeCompactBody}" TextAlignment="Right" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding RateBasis}" Style="{StaticResource ItemSubtitle}" TextAlignment="Right" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="Cycle" Style="{StaticResource ItemSubtitle}"/>
                                <TextBlock Text="{Binding CycleProgressText}" Margin="0,4,0,0" ToolTip="Verified sessions in the current cap cycle"/>
                                <ProgressBar Style="{StaticResource MetricProgressBar}" Value="{Binding CycleProgressPercent, Mode=OneWay}" Height="4" Margin="0,4,0,0" Visibility="{Binding HasCycleProgress, Converter={StaticResource Show}}"/>
                                <TextBlock Text="{Binding CycleStatusText}" Style="{StaticResource ItemSubtitle}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Acquisition" Style="{StaticResource ItemSubtitle}"/>
                                <TextBlock Text="{Binding PriceText}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" ToolTip="{Binding PriceTooltip}"/>
                                <TextBlock Text="{Binding LibraryPriceEvidence}" Style="{StaticResource PageDescription}"/>
                            </StackPanel>
                        </Grid>
                        <Button Grid.Column="3" Grid.RowSpan="3" HorizontalAlignment="Right" Command="{Binding ToggleBookmarkCommand}" Style="{StaticResource BookmarkButton}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="{Binding BookmarkAccessibleName}" AutomationProperties.Name="{Binding BookmarkAccessibleName}">
                            <fluent:FluentIcon Icon="Bookmark" IconSize="Size20" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"><fluent:FluentIcon.Style><Style TargetType="fluent:FluentIcon"><Setter Property="IconVariant" Value="Regular"/><Style.Triggers><DataTrigger Binding="{Binding IsBookmarked}" Value="True"><Setter Property="IconVariant" Value="Filled"/></DataTrigger></Style.Triggers></Style></fluent:FluentIcon.Style></fluent:FluentIcon>
                        </Button>
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding GamePassStatus}" Style="{StaticResource GamePassEvidence}"/>
                    </Grid>
                    <DataTemplate.Triggers><DataTrigger Binding="{Binding IsCompactLibrary, RelativeSource={RelativeSource AncestorType=local:GamesView}}" Value="True">
                        <Setter TargetName="Artwork" Property="Grid.RowSpan" Value="2"/>
                        <Setter TargetName="Title" Property="Grid.ColumnSpan" Value="2"/>
                        <Setter TargetName="Comparisons" Property="Grid.Row" Value="1"/><Setter TargetName="Comparisons" Property="Grid.Column" Value="1"/><Setter TargetName="Comparisons" Property="Grid.ColumnSpan" Value="2"/>
                        <Setter TargetName="Comparisons" Property="Width" Value="Auto"/><Setter TargetName="Comparisons" Property="Margin" Value="0,12,0,0"/>
                    </DataTrigger></DataTemplate.Triggers>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="GamesEmptyState" Grid.Row="3" Text="{Binding EmptyStateText}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowEmptyState}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
        <Grid x:Name="GameDetailsView" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Button x:Name="DetailsBackButton" AutomationProperties.Name="Back to games" Grid.Row="0" Click="GameDetailsBackButton_Click" HorizontalAlignment="Left" Style="{StaticResource LinkButtonStyle}" Margin="0,0,0,12">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <fluent:FluentIcon
                        Grid.Column="0"
                        Icon="ArrowPrevious"
                        Foreground="{StaticResource SecondaryTextColor}"
                        Margin="0,0,0,0"/>

                            <TextBlock
                        Grid.Column="1"
                        Text="Games"
                        VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextColor}" FontSize="{StaticResource FontSizeSupporting}" FontWeight="SemiBold"/>
                        </Grid>
            </Button>
          <!-- The header is the first item on the same finite, pixel-scrolling virtualized surface. -->
          <ListBox Grid.Row="1" x:Name="GameSessionsList" Background="Transparent" BorderThickness="0"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                   VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ItemButton}">
                    <Setter Property="Margin" Value="0,0,12,0"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource DefaultBorderColor}"/>
                    <Setter Property="BorderThickness" Value="1,0,1,1"/>
                    <Setter Property="Template"><Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="SessionRowSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SessionRowSurface" Property="Background" Value="{StaticResource CardBackgroundColor}"/></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="SessionRowSurface" Property="Background" Value="{StaticResource AccentBackgroundColor}"/></Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SessionRowSurface" Property="BorderBrush" Value="{StaticResource AccentColor}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value></Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Game.IsArchived}" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource VerticalScrollBar}"/>
                <DataTemplate DataType="{x:Type models:Session}">
                    <Grid Margin="0 0 10 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding DateTimeText}" Style="{StaticResource GameSessionDetailsStyle}"/>
                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource GameSessionDetailsStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EarningsText}" Style="{StaticResource SectionHeading}" HorizontalAlignment="Right"/>
                            <Border Style="{StaticResource DetailedSessionStatusBadge}" Margin="0,8,0,0" HorizontalAlignment="Right">
                                <TextBlock Style="{StaticResource DetailedSessionStatusText}" FontSize="{StaticResource FontSizeSupporting}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.Resources>
            <ListBox.ItemsSource>
              <CompositeCollection>
                <ListBoxItem Focusable="False" IsTabStop="False" FontWeight="Normal" Padding="0" Margin="0" HorizontalContentAlignment="Stretch">
                  <ListBoxItem.Template>
                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                  </ListBoxItem.Template>
                   <Grid Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>

            <!--Game Header-->
            <Border Grid.Row="1" Style="{StaticResource GameDetailPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="76" Height="104" Background="{StaticResource ArchivedBackgroundColor}" Margin="0,0,16,0">
                            <ContentControl Style="{StaticResource GameArtwork}" Content="{Binding Catalog.Cover}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Game.Name}" Style="{StaticResource TabName}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Catalog.GenreText}" Style="{StaticResource PageDescription}"/>
                            <TextBlock Text="{Binding Catalog.RateBasis}" Style="{StaticResource PageDescription}"/>
                            <TextBlock Text="Archived · historical rate" Foreground="{StaticResource ArchivedTextColor}" TextWrapping="Wrap" Visibility="{Binding Game.IsArchived, Converter={StaticResource Show}}"/>
                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding Game.RatePerHour, StringFormat={}{0:C2}/hr, ConverterCulture=en-US}" Style="{StaticResource SectionHeading}" Margin="0,0,16,4"/>
                                <TextBlock Text="{Binding Catalog.PriceText}" Style="{StaticResource ItemSubtitle}" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <Button DataContext="{Binding Catalog}" Command="{Binding ToggleOwnedCommand}" Content="{Binding OwnershipButtonText}" Style="{StaticResource OwnershipButton}" ToolTip="{Binding OwnershipTooltip}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Catalog.OwnershipError}" Style="{StaticResource InlineValidationText}"/>
                            <TextBlock DataContext="{Binding Catalog}" Text="{Binding GamePassStatus}" Style="{StaticResource GamePassEvidence}"/>
                        </StackPanel>
                        <Button Grid.Column="2" DataContext="{Binding Catalog}" Command="{Binding ToggleBookmarkCommand}" Style="{StaticResource BookmarkButton}" Margin="8,0,0,0" AutomationProperties.Name="{Binding BookmarkAccessibleName}" ToolTip="{Binding BookmarkAccessibleName}">
                            <fluent:FluentIcon Icon="Bookmark" IconSize="Size20" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <fluent:FluentIcon.Style><Style TargetType="fluent:FluentIcon">
                                    <Setter Property="IconVariant" Value="Regular"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsBookmarked}" Value="True"><Setter Property="IconVariant" Value="Filled"/></DataTrigger></Style.Triggers>
                                </Style></fluent:FluentIcon.Style>
                            </fluent:FluentIcon>
                        </Button>
                    </Grid>

                </Grid>
            </Border>

            <Grid x:Name="DetailColumns" Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel x:Name="DetailLeft">
                    <Border Style="{StaticResource GameDetailPanel}" Padding="16" Margin="0,12,0,16">
                        <StackPanel>
                            <TextBlock Text="Earnings &amp; cap" Style="{StaticResource SectionHeading}"/>
                            <UniformGrid Columns="2" Margin="0,16,0,12">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Verified play time" Style="{StaticResource PageDescription}"/>
                                    <TextBlock Text="{Binding TotalDurationText}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Full-cycle potential" Style="{StaticResource PageDescription}"/>
                                    <TextBlock Text="{Binding Catalog.PotentialText}" ToolTip="Rate × full cycle cap" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                            <ProgressBar Style="{StaticResource MetricProgressBar}" Value="{Binding ProgressPercentage, Mode=OneWay}" AutomationProperties.Name="Verified minute cap utilization"/>
                            <TextBlock Text="{Binding ProgressDescription}" Style="{StaticResource PageDescription}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding MinutesDescription}" Style="{StaticResource PageDescription}" Margin="0,4,0,12"/>
                            <TextBlock Style="{StaticResource SectionHeading}"><Run Text="{Binding TotalEarnings, Mode=OneWay, StringFormat={}{0:C2}, ConverterCulture=en-US}"/><Run Text=" verified earnings"/></TextBlock>
                            <TextBlock Text="{Binding EarningsDescription}" Style="{StaticResource PageDescription}" Margin="0,4,0,12"/>
                            <Separator Margin="0,0,0,12"/>
                            <TextBlock Text="Cap reset date" Style="{StaticResource GameDetailPanelLabel}"/>
                            <TextBlock Text="Blank = all verified history" Style="{StaticResource GameDetailPanelDescription}" Margin="0,4,0,8"/>
                            <WrapPanel>
                                <DatePicker AutomationProperties.Name="Cap reset date" x:Name="CapResetDatePicker" SelectedDate="{Binding Game.CapResetDate, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <Button Content="Save reset date" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Click="SaveCapResetDateButton_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SurfacePanel}" Margin="0,0,0,12"><StackPanel>
                        <TextBlock Text="Ownership &amp; access" Style="{StaticResource SectionHeading}"/>

                        <TextBlock Text="{Binding Catalog.PurchaseEvidence}" Style="{StaticResource PageDescription}"/>
                        <TextBlock Text="{Binding Catalog.BreakEvenText}" Style="{StaticResource PageDescription}"/>
                        <Button Content="Edit ownership" Style="{StaticResource SecondaryButton}" Click="Ownership_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                        <TextBlock Text="Subscription evidence" Style="{StaticResource SectionHeading}" Margin="0,16,0,0"/>
                        <TextBlock Text="No saved subscription evidence.">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PageDescription}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Catalog.SubscriptionDetails.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <ItemsControl x:Name="SubscriptionEvidenceList" ItemsSource="{Binding Catalog.SubscriptionDetails}">
                            <ItemsControl.Resources>
                                <Style x:Key="SubscriptionStatusText" TargetType="TextBlock" BasedOn="{StaticResource PageDescription}">
                                    <Setter Property="Foreground" Value="{StaticResource DefaultTextColor}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource PendingTextColor}"/></DataTrigger></Style.Triggers>
                                </Style>
                                <DataTemplate x:Key="SubscriptionLink">
                                    <Button Style="{StaticResource LinkButtonStyle}" Click="OpenCatalogLink_Click" Tag="{Binding Url}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource SubscriptionStatusText}"/>
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource PageDescription}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                                <DataTemplate x:Key="SubscriptionPlainText">
                                    <TextBlock Text="{Binding Text}" ToolTip="{Binding Details}" Style="{StaticResource SubscriptionStatusText}"/>
                                </DataTemplate>
                            </ItemsControl.Resources>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <ContentControl Content="{Binding}" Margin="0,8,0,0" HorizontalContentAlignment="Stretch" Focusable="False">
                                    <ContentControl.Style><Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SubscriptionLink}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding CanOpenLink}" Value="False"><Setter Property="ContentTemplate" Value="{StaticResource SubscriptionPlainText}"/></DataTrigger></Style.Triggers>
                                    </Style></ContentControl.Style>
                                </ContentControl>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel></Border>
                </StackPanel>
                <StackPanel x:Name="DetailRight" Grid.Column="2">
                    <Border Style="{StaticResource SurfacePanel}" Margin="0,12,0,12"><StackPanel x:Name="CatalogDetailsPanel">
                        <TextBlock Text="Acquisition options" Style="{StaticResource SectionHeading}"/>

                        <TextBlock Text="{Binding Catalog.AccessStatusText}">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PageDescription}"><Style.Triggers>
                                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Catalog.OfferDetails}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource SurfacePanel}" Margin="0,8,0,0" Padding="12">
                                <StackPanel>
                                    <Button Style="{StaticResource SecondaryButton}" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{StaticResource AccentTextColor}" Click="OpenCatalogLink_Click" Tag="{Binding Url}" ToolTip="{Binding Tooltip}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <TextBlock Text="{Binding Heading}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    </Button>
                                    <TextBlock Text="{Binding Price}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,6"/>
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource PageDescription}"/>
                                    <Expander Header="Availability &amp; source" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Tooltip}" Style="{StaticResource PageDescription}"/>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Expander x:Name="CatalogProvenance" Header="Catalog details" Margin="0,16,0,0">
                            <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource InlineDisclosure}"><Setter Property="IsExpanded" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding Catalog.Metadata.Reviewed}" Value="True"><Setter Property="IsExpanded" Value="False"/></DataTrigger></Style.Triggers></Style></Expander.Style>
                            <TextBlock Text="{Binding Catalog.MetadataStatus}" Style="{StaticResource PageDescription}"/>
                        </Expander>
                    </StackPanel></Border>
                    <Border Style="{StaticResource GameDetailPanel}" Padding="16" Margin="0,0,0,12"><StackPanel>
                    <TextBlock Text="History &amp; evidence" Style="{StaticResource SectionHeading}" Margin="0,0,0,8"/>
                    <Button Content="Session history ↓" Style="{StaticResource SecondaryButton}" Click="SessionHistory_Click" Margin="0,0,0,12"/>


                    <Expander Header="Rate history" Margin="0,0,0,12"><StackPanel>
                        <TextBlock Text="{Binding HistoryEvidenceText}" Style="{StaticResource PageDescription}" Margin="0,8,0,8"/>
                        <ListBox ItemsSource="{Binding RateIdentities}" MaxHeight="180" Background="Transparent" BorderThickness="0" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate>
                            <TextBlock TextWrapping="Wrap"><Run Text="{Binding Name}"/><Run Text=" · #"/><Run Text="{Binding Id}"/><Run Text=" · "/><Run Text="{Binding RatePerHour, StringFormat={}{0:C2}/hr, ConverterCulture=en-US}"/><Run Text=" · "/><Run Text="{Binding MinutesCap}"/><Run Text=" min cap · archived: "/><Run Text="{Binding IsArchived}"/></TextBlock>
                        </DataTemplate></ListBox.ItemTemplate></ListBox>
                    </StackPanel></Expander>
                    <Expander Header="Cap-reset history" Margin="0,0,0,12"><StackPanel>
                        <TextBlock Text="No reset history" Margin="0,8,0,0">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PageDescription}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CapResetHistory.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <ListBox ItemsSource="{Binding CapResetHistory}" MaxHeight="240" Background="Transparent" BorderThickness="0" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><Expander Margin="0,8">
                            <Expander.Header><TextBlock Text="{Binding ChangedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/></Expander.Header>
                            <StackPanel><TextBlock Text="{Binding ChangeType}"/><TextBox Text="{Binding BeforeValuesJson, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ModalTextBox}" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto"/><TextBox Text="{Binding AfterValuesJson, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ModalTextBox}" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto"/></StackPanel>
                        </Expander></DataTemplate></ListBox.ItemTemplate></ListBox>
                    </StackPanel></Expander>
                    </StackPanel></Border>
                    <Border Margin="0,0,0,16">
                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource SurfacePanel}"><Style.Triggers><DataTrigger Binding="{Binding Catalog.Summary}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel>
                        <TextBlock Text="About this game" Style="{StaticResource ItemSubtitle}"/>
                        <TextBlock Text="{Binding Catalog.Summary}" Style="{StaticResource PageDescription}"/>
                    </StackPanel></Border>
                </StackPanel>
            </Grid>
            <!--Add Session-->
            <StackPanel Grid.Row="4" Margin="0,8">
                <TextBlock Text="{Binding BookmarkError}" DataContext="{Binding DataContext, ElementName=Root}" Style="{StaticResource InlineValidationText}" Margin="0,0,0,8"/>
                <!-- Game Details import is deferred beyond v1.0.0; retain the implementation. -->
                <Button x:Name="AddSessionButton" Visibility="Collapsed" Content="Add Session" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="AddSessionButton_Click"/>
            </StackPanel>
            <!--Sessions-->
            <Border Grid.Row="5" Style="{StaticResource SurfacePanel}" CornerRadius="8,8,0,0" Margin="0 4 0 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeading}" Text="{Binding FilteredSessionString}"/>
                    <ItemsControl x:Name="SessionFilterList" Grid.Row="1" ItemsSource="{Binding StatusFilters}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <RadioButton Content="{Binding DisplayText}" GroupName="GameDetailStatusFilters" IsChecked="{Binding IsSelected, Mode=OneWay}" Style="{StaticResource SessionFilterChip}" Checked="DetailSessionFilter_Checked"/>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="2" Text="{Binding SessionEmptyText}" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
           </Grid>
                </ListBoxItem>
                <CollectionContainer x:Name="SessionRowsCollection"/>
              </CompositeCollection>
            </ListBox.ItemsSource>
          </ListBox>
        </Grid>
    </Grid>
</UserControl>
