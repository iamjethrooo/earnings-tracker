<UserControl x:Class="EarningsTracker.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource DefaultTextColor}"/>
   <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,6"/>
  </Style>
  <Style TargetType="Expander">
   <Setter Property="Foreground" Value="{StaticResource DefaultTextColor}"/>
   <Setter Property="Margin" Value="0,8,0,0"/>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="20" MaxWidth="760" HorizontalAlignment="Stretch">
   <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Settings" Style="{StaticResource TabName}"/>

            </StackPanel>
   <TextBlock x:Name="Feedback" Foreground="{StaticResource SecondaryTextColor}" AutomationProperties.LiveSetting="Polite">
    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
     <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
    </Style></TextBlock.Style>
   </TextBlock>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SurfacePanel}"><StackPanel>
     <TextBlock Text="Active subscriptions" Style="{StaticResource CompactSectionHeading}"/>
     <CheckBox x:Name="GamePass" Content="PC Game Pass" Click="Subscription_Click" MinHeight="32" VerticalContentAlignment="Center" ToolTip="Select if your membership is active. Changes save automatically."/>
     <Expander Header="Availability"><TextBlock Text="{Binding SubscriptionStatus}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" ToolTip="Playable now requires current Philippine PC availability and an active membership. The PC Game Pass filter retains previously verified inclusion with a stale warning after seven days or expiry."/></Expander>
    </StackPanel></Border>
    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SurfacePanel}"><StackPanel>
     <TextBlock Text="Catalog updates" Style="{StaticResource CompactSectionHeading}"/>
     <DockPanel>
      <Button x:Name="Refresh" DockPanel.Dock="Right" Content="Refresh now" Click="Refresh_Click" Style="{StaticResource SecondaryButton}" Padding="10,7" Margin="8,0,0,0"/>
      <CheckBox x:Name="Automatic" Content="Check daily when Games opens" Click="Automatic_Click" VerticalAlignment="Center" ToolTip="Check catalog and exchange rates when Games opens, at most daily. Live prices refresh only manually."/>
     </DockPanel>
     <Expander Header="Update details"><TextBlock Text="{Binding UpdateStatus}" Margin="0,8,0,0"/></Expander>
    </StackPanel></Border>
    <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource SurfacePanel}"><StackPanel>
     <DockPanel>
      <TextBlock x:Name="KeyStatus" DockPanel.Dock="Right" Foreground="{StaticResource SecondaryTextColor}" Margin="12,0,0,0"/>
      <TextBlock Text="IsThereAnyDeal API key" Style="{StaticResource CompactSectionHeading}" ToolTip="Optional. Enables manual live price refresh."/>
     </DockPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <PasswordBox x:Name="ApiKey" Padding="8" MaxLength="1000" Background="{StaticResource DefaultBackgroundColor}" Foreground="{StaticResource DefaultTextColor}" BorderBrush="{StaticResource DefaultBorderColor}" AutomationProperties.Name="Replacement IsThereAnyDeal API key" ToolTip="Optional key for live prices. Enter a replacement or leave blank to keep the saved key."/>
      <Button Grid.Column="1" Content="Save" Click="SaveKey_Click" Style="{StaticResource PrimaryButton}" Padding="12,7" Margin="8,0,0,0"/>
      <Button Grid.Column="2" Content="Remove" Click="RemoveKey_Click" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="8,0,0,0"/>
     </Grid>
    </StackPanel></Border>
    <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource SurfacePanel}"><StackPanel>
     <TextBlock Text="Currency &amp; region" Style="{StaticResource CompactSectionHeading}"/>
     <TextBlock Text="Philippines · PC"/>
     <TextBlock Text="Prices: PHP · Earnings: USD" Margin="0" ToolTip="Region and currencies are fixed for the supported catalog."/>
     <TextBlock Text="{Binding RateStatus}" Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextColor}"/>
    </StackPanel></Border>
    <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource SurfacePanel}"><StackPanel>
     <TextBlock Text="Support &amp; about" Style="{StaticResource CompactSectionHeading}"/>
     <Button Content="Export diagnostics" Click="Export_Click" Style="{StaticResource SecondaryButton}" Padding="10,7" HorizontalAlignment="Left" ToolTip="Exports version, update timestamps and outcomes. Excludes credentials and financial records."/>
     <StackPanel Margin="0,8,0,0">
      <TextBlock Text="Metadata: IGDB · Prices: IsThereAnyDeal · Rates: Frankfurter"/>
      <TextBlock Text="{Binding DataFolder, StringFormat=Local data: {0}}" Margin="0"/>
     </StackPanel>
    </StackPanel></Border>
   </Grid>
   <Border x:Name="SteamPanel" Style="{StaticResource SurfacePanel}" Margin="0,10,0,0"><StackPanel>
    <TextBlock Text="Steam account" Style="{StaticResource CompactSectionHeading}"/>
    <TextBlock Text="Sync Steam to mark matching games as owned." Foreground="{StaticResource SecondaryTextColor}"/>
    <TextBlock Text="{Binding SteamStatus}" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock x:Name="SteamFeedback" AutomationProperties.LiveSetting="Polite"/>
    <StackPanel x:Name="SteamControls">
     <Label Target="{Binding ElementName=SteamProfile}" Content="Steam profile URL or ID" Foreground="{StaticResource DefaultTextColor}" Padding="0,0,0,4"/>
     <TextBox x:Name="SteamProfile" Style="{StaticResource ModalTextBox}" MaxLength="250" Margin="0,0,0,8" AutomationProperties.Name="Steam profile URL or SteamID64"/>
     <Label Target="{Binding ElementName=SteamKey}" Content="Steam Web API key" Foreground="{StaticResource DefaultTextColor}" Padding="0,0,0,4"/>
     <PasswordBox x:Name="SteamKey" MaxLength="32" Padding="8" Background="{StaticResource DefaultBackgroundColor}" Foreground="{StaticResource DefaultTextColor}" BorderBrush="{StaticResource DefaultBorderColor}" AutomationProperties.Name="Personal Steam Web API key"/>
     <TextBlock Text="Stored in Windows Credential Manager." Foreground="{StaticResource SecondaryTextColor}" Margin="0,6,0,8"/>
     <WrapPanel>
      <Button x:Name="SteamLink" Content="Link account" Click="SteamLink_Click" Style="{StaticResource PrimaryButton}" Padding="10,7" Margin="0,0,8,8"/>
      <Button x:Name="SteamSync" Content="Sync now" Click="SteamSync_Click" IsEnabled="{Binding SteamLinked}" Style="{StaticResource SecondaryButton}" Padding="10,7" Margin="0,0,8,8"/>
      <Button x:Name="SteamUnlink" Content="Unlink" ToolTip="Removes Steam ownership only. Manual ownership and purchase costs are kept." Click="SteamUnlink_Click" IsEnabled="{Binding SteamLinked}" Style="{StaticResource SecondaryButton}" Padding="10,7" Margin="0,0,8,8"/>
      <Button Content="Get a Steam API key" Click="SteamKeyHelp_Click" Style="{StaticResource SecondaryButton}" Padding="10,7" Margin="0,0,0,8"/>
     </WrapPanel>
     <CheckBox x:Name="SteamAutomatic" Content="Sync when Games opens (at most daily)" Click="SteamAutomatic_Click" Margin="0,0,0,4"/>
     <Expander Header="Sync details"><StackPanel Margin="0,8,0,0">
      <TextBlock Text="Use your own API key. If your library is unavailable, set Steam → Edit Profile → Privacy Settings → Game details to Public." Foreground="{StaticResource SecondaryTextColor}"/>
      <TextBlock Text="Owned and Playable now use the last successful sync. Refresh catalog also syncs Steam. Unavailable libraries keep saved ownership. Unlinking removes Steam ownership only; manual ownership and purchase costs stay saved. Unmatched games remain manual." Foreground="{StaticResource SecondaryTextColor}"/>
     </StackPanel></Expander>
    </StackPanel>
   </StackPanel></Border>
   <Border Style="{StaticResource SurfacePanel}" Margin="0,10,0,0"><StackPanel>
    <TextBlock Text="Games display" Style="{StaticResource CompactSectionHeading}"/>

    <TextBlock Text="Default sort" Style="{StaticResource FilterLabel}"/>
    <ComboBox x:Name="GamesDefaultSort" AutomationProperties.Name="Default Games sort" SelectionChanged="GamesDefaultSort_SelectionChanged" HorizontalAlignment="Left" MinWidth="160" Margin="0,0,0,8">
     <ComboBoxItem Content="Highest rate"/><ComboBoxItem Content="Name A–Z"/><ComboBoxItem Content="Newest"/><ComboBoxItem Content="Lowest price"/>
    </ComboBox>
    <CheckBox x:Name="GamesBookmarksOnly" Content="Start with bookmarked games" Click="GamesBookmarksOnly_Click" Margin="0,0,0,8" ToolTip="Show bookmarked games when Games opens. You can turn this filter off on the Games page."/>
    <CheckBox x:Name="GamesShowArchived" Content="Show archived games" Click="GamesShowArchived_Click" ToolTip="Include archived games in the Games list. Archived game history remains available."/>
   </StackPanel></Border>
   <Border Style="{StaticResource SurfacePanel}" Margin="0,10,0,0"><StackPanel>
    <TextBlock Text="Backup &amp; restore" Style="{StaticResource CompactSectionHeading}"/>
    <TextBlock Text="Includes saved records and settings, Steam account ID and cached library. Excludes API keys and cached artwork." Foreground="{StaticResource SecondaryTextColor}"/>
    <WrapPanel Margin="0,4,0,0">
     <Button x:Name="BackupButton" Content="Create backup" Click="Backup_Click" Style="{StaticResource SecondaryButton}" Padding="10,7" Margin="0,0,8,8" AutomationProperties.Name="Create application data backup"/>
     <Button x:Name="RestoreButton" Content="Restore backup" Click="Restore_Click" Style="{StaticResource SecondaryButton}" Padding="10,7" Margin="0,0,0,8" AutomationProperties.Name="Restore application data from backup"/>
    </WrapPanel>
    <TextBlock Text="Restore replaces saved data and requires reopening the app." Foreground="{StaticResource SecondaryTextColor}" Margin="0"/>
   </StackPanel></Border>
   <Border Style="{StaticResource SurfacePanel}" Margin="0,10,0,0"><StackPanel>
    <TextBlock Text="Application updates" Style="{StaticResource CompactSectionHeading}"/>
    <CheckBox x:Name="ApplicationStartup" Content="Check when the application starts" IsChecked="{Binding CheckApplicationOnStartup, Mode=OneWay}" Click="ApplicationStartup_Click" Margin="0,0,0,8"/>
    <StackPanel DataContext="{Binding ApplicationUpdates}">
     <TextBlock Text="{Binding CurrentVersion}" Foreground="{StaticResource SecondaryTextColor}"/>
     <TextBlock Text="{Binding Message, TargetNullValue=Application updates unavailable.}" AutomationProperties.LiveSetting="Polite"/>
     <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="6" Margin="0,0,0,8">
      <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDownloading}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
     </ProgressBar>
     <WrapPanel>
      <Button Content="Check for updates" Click="CheckApplication_Click" IsEnabled="{Binding CanCheck, FallbackValue=False}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="10,7"/>
      <Button Content="Download update" Click="DownloadApplication_Click" IsEnabled="{Binding CanDownload, FallbackValue=False}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="10,7"/>
      <Button Content="Cancel" Click="CancelApplication_Click" IsEnabled="{Binding CanCancel, FallbackValue=False}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="10,7"/>
      <Button Content="Restart and update" Click="RestartApplication_Click" IsEnabled="{Binding CanRestart, FallbackValue=False}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Padding="10,7"/>
     </WrapPanel>
     <TextBlock Text="{Binding RestartHint}" Foreground="{StaticResource SecondaryTextColor}" Margin="0"/>
     <TextBlock Text="Downloads and restarts are manual." Foreground="{StaticResource SecondaryTextColor}" Margin="0,4,0,0"/>
    </StackPanel>
   </StackPanel></Border>
  </StackPanel>
 </ScrollViewer>
  <Border Grid.Row="1" MaxWidth="760" Margin="20,0,20,20" Padding="0,12,0,0"
          BorderBrush="{StaticResource DefaultBorderColor}" BorderThickness="0,1,0,0">
   <DockPanel>
    <TextBlock x:Name="BuildFooter" Text="{Binding BuildLabel}" ToolTip="{Binding AssemblyVersionLabel}" DockPanel.Dock="Right"
               FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Margin="12,0,0,0"/>
    <TextBlock Text="Earnings Tracker" Foreground="{StaticResource SecondaryTextColor}" Margin="0"/>
   </DockPanel>
  </Border>
 </Grid>
</UserControl>
