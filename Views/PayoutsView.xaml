<UserControl x:Class="EarningsTracker.Views.PayoutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <Style x:Key="AmountColumnHeader" TargetType="GridViewColumnHeader" BasedOn="{StaticResource TableColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="AccountMetric" TargetType="Border" BasedOn="{StaticResource MetricPanel}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
        </Style>
    </UserControl.Resources>
    <Grid Style="{StaticResource TabMainGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Payments" Style="{StaticResource PageTitle}"/><TextBlock Text="All-time account totals · USD" Style="{StaticResource PageDescription}"/>

            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Add payout" Click="AddPayoutButton_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Content="Import payouts" Click="ImportPayoutsButton_Click" Style="{StaticResource PrimaryButton}" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Margin="0,8,0,12" Padding="0,8"
                Background="Transparent" BorderThickness="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Processing is not confirmation of receipt. Unpaid earnings follow session assignments and posted dates."
                               Style="{StaticResource PageDescription}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="SessionReadOnlyNotice" Visibility="Collapsed" Text="Session earnings are read-only here." Style="{StaticResource DashboardStatDescription}" TextWrapping="Wrap" Margin="0,0,16,0"/>
                    <TextBlock x:Name="ReconciliationNotice" Foreground="{StaticResource PendingTextColor}" FontSize="{StaticResource FontSizeSupporting}" TextWrapping="Wrap" Margin="0,8,16,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="UndatedSessionsNotice" Foreground="{StaticResource PendingTextColor}" FontSize="{StaticResource FontSizeSupporting}" TextWrapping="Wrap" Margin="0,8,16,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    <Expander Header="How calculated" Margin="0,4,16,0" AutomationProperties.Name="Payment calculation details">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Total earned includes verified sessions and eligible separate bonuses/corrections. Separate adjustments count when Verified, Paid, or Processing; included adjustments aren't added again." Style="{StaticResource DashboardStatDescription}" TextWrapping="Wrap"/>
                            <TextBlock Text="Paid + processing includes payments in either status; processing is not confirmation of receipt. Unpaid verified earnings includes verified sessions in Current payout and historical sessions after the latest Paid/Processing payment day. Hidden or inactive payment assignments return to Current payout. Missing posted dates and separate adjustments are excluded from Unpaid verified earnings." Style="{StaticResource DashboardStatDescription}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="LoadStatusPanel" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource FeedbackPanel}">
            <DockPanel>
                <Button x:Name="RetryLoadButton" DockPanel.Dock="Right" Content="Retry" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="12,0,0,0" Click="RetryLoadButton_Click"/>
                <TextBlock x:Name="LoadStatusText" Foreground="{StaticResource SecondaryTextColor}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </Border>
        <Grid x:Name="TotalsPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource AccountMetric}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Total earned" Style="{StaticResource DashboardStatLabel}"/>
                    <Viewbox Height="48" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                        <TextBlock x:Name="TotalEarnedValue" Style="{StaticResource DashboardStatValue}" FontSize="36" Foreground="{StaticResource DefaultTextColor}"/>
                    </Viewbox>
                    <TextBlock Text="Verified sessions + separate adjustments" Style="{StaticResource DashboardStatDescription}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource AccountMetric}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Paid + processing" Style="{StaticResource DashboardStatLabel}"/>
                    <Viewbox Height="48" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                        <TextBlock x:Name="TotalPaidValue" Style="{StaticResource DashboardStatValue}" FontSize="36" Foreground="{StaticResource DefaultTextColor}"/>
                    </Viewbox>
                    <TextBlock x:Name="PaidBreakdown" Text="Paid and processing payments" Style="{StaticResource DashboardStatDescription}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource AccountMetric}" Margin="0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Unpaid verified earnings" Style="{StaticResource DashboardStatLabel}" TextWrapping="Wrap"/>
                    <Viewbox Height="48" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                        <TextBlock x:Name="AmountOwedValue" Style="{StaticResource DashboardStatValue}" FontSize="36" Foreground="{StaticResource DefaultTextColor}"/>
                    </Viewbox>
                    <TextBlock Text="Verified unpaid sessions with known posted dates" ToolTip="Verified sessions in Current payout, plus historical sessions after the latest Paid or Processing payment day. Sessions assigned to an inactive or hidden payment return to Unpaid verified earnings. Unknown posted dates and separate adjustments remain excluded." Style="{StaticResource DashboardStatDescription}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="HistoryPanel" Grid.Row="4" Visibility="Collapsed" Style="{StaticResource OpenSectionPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="EditButton" Content="Edit selected" Click="EditPayoutButton_Click" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,0,8,0"/>
                        <Button x:Name="PayoutActionsButton" Content="More actions" AutomationProperties.Name="More payment actions" Click="PayoutActions_Click"
                                Style="{StaticResource SecondaryButton}" IsEnabled="False" ToolTip="Only manual records can be hidden." ToolTipService.ShowOnDisabled="True">
                            <Button.ContextMenu>
                                <ContextMenu Background="{StaticResource DialogBackgroundColor}" Foreground="{StaticResource DefaultTextColor}">
                                    <MenuItem x:Name="DeleteButton" Header="Hide manual record…" IsEnabled="False" Click="DeletePayoutButton_Click"
                                              ToolTip="Excludes this manual record from totals and history; its audit is retained. Payment coverage may return to unpaid earnings."/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Transaction history" Style="{StaticResource ContentHeading}" VerticalAlignment="Center"/>
                </DockPanel>
                <ListView Grid.Row="1" x:Name="PayoutList" ItemsSource="{Binding History}" SelectionChanged="PayoutList_SelectionChanged"
                          ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          GridViewColumnHeader.Click="PayoutList_ColumnHeaderClick"
                          SizeChanged="PayoutList_SizeChanged"
                          Background="Transparent" BorderThickness="0" Padding="0" FontSize="{StaticResource FontSizeBody}" AutomationProperties.Name="Transaction history" SelectionMode="Single"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource TableRow}">
                <Setter Property="Padding" Value="8,10"/><Setter Property="MinHeight" Value="52"/>
            </Style></ListView.ItemContainerStyle>
            <ListView.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource VerticalScrollBar}"/>
                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource TableColumnHeader}"/>
            </ListView.Resources>
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="POSTED" Width="100" DisplayMemberBinding="{Binding PostedText}"/>
                    <GridViewColumn Header="RECORDED" Width="100" DisplayMemberBinding="{Binding RecordedText}"/>
                    <GridViewColumn Header="TYPE" Width="130">
                        <GridViewColumn.CellTemplate><DataTemplate>
                            <Border Background="{Binding TypeBackground}" Style="{StaticResource TransactionBadge}">
                                <TextBlock Text="{Binding Type}" Foreground="{Binding TypeForeground}" Style="{StaticResource TransactionBadgeText}" TextWrapping="Wrap"/>
                            </Border>
                        </DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="DESCRIPTION" Width="200">
                        <GridViewColumn.CellTemplate><DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                <Border Background="{Binding ReconciliationBackground}" Margin="0,8,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource TransactionBadge}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ReconciliationText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ToolTip>
                                        <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <TextBlock Text="{Binding ReconciliationExplanation}" TextWrapping="Wrap"/>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <TextBlock Text="{Binding ReconciliationText}" Foreground="{Binding ReconciliationForeground}" Style="{StaticResource TransactionBadgeText}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="STATUS" Width="110">
                        <GridViewColumn.CellTemplate><DataTemplate>
                            <Border Background="{Binding StatusBackground}" Style="{StaticResource TransactionBadge}">
                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}" Style="{StaticResource TransactionBadgeText}"/>
                            </Border>
                        </DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="AMOUNT" Width="125" HeaderContainerStyle="{StaticResource AmountColumnHeader}">
                        <GridViewColumn.CellTemplate><DataTemplate>
                            <TextBlock Text="{Binding AmountText}" Foreground="{Binding AmountForeground}" FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Stretch" Padding="4"/>
                        </DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
                </ListView>
            <TextBlock x:Name="PayoutsViewEmptyState" Grid.Row="1" Text="No transactions yet. Import sessions or add a payout to get started.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
