<Window x:Class="EarningsTracker.Prototypes.PrototypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EarningsTracker.Prototypes"
        xmlns:sessions="clr-namespace:EarningsTracker.Prototypes.Sessions"
        xmlns:games="clr-namespace:EarningsTracker.Prototypes.Games"
        xmlns:enums="clr-namespace:EarningsTracker.Enums"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Earnings Tracker · Synthetic UI prototype" Width="1440" Height="960" MinWidth="1000" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="{StaticResource DefaultTextColor}"
        Background="{StaticResource DefaultBackgroundColor}" UseLayoutRounding="True" KeyDown="Window_KeyDown"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIf"/>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource DashboardStatDescription}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource MetricPanel}">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource DefaultBorderColor}"/>
        </Style>
        <Style x:Key="PeriodButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextColor}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Padding="12,8" CornerRadius="6" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource ControlHoverColor}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBackgroundColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentTextColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GameLink" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></DataTemplate></Setter.Value></Setter>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource AccentTextColor}"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ValuesExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextColor}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      HorizontalAlignment="Left" FocusVisualStyle="{StaticResource KeyboardFocusVisual}" AutomationProperties.Name="Expand daily earnings values">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent" Padding="0,4" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Arrow" Text="›" Foreground="{StaticResource AccentTextColor}" Width="16" FontSize="14"/>
                                        <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="⌄"/></Trigger></ControlTemplate.Triggers>
                            </ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Values" ContentSource="Content" Visibility="Collapsed" Margin="0,8,0,0"/>
                    </StackPanel>
                    <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Values" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root" Background="{StaticResource DefaultBackgroundColor}">
        <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{StaticResource SidebarBackgroundColor}" BorderBrush="{StaticResource DefaultBorderColor}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="─" Width="42" Style="{StaticResource WindowButtonStyle}" Click="Minimize_Click" AutomationProperties.Name="Minimize prototype"/>
                    <Button Content="□" Width="42" Style="{StaticResource WindowButtonStyle}" Click="Maximize_Click" AutomationProperties.Name="Maximize or restore prototype"/>
                    <Button Content="×" Width="42" Style="{StaticResource CloseButtonStyle}" Click="Close_Click" AutomationProperties.Name="Close prototype"/>
                </StackPanel>
                <TextBlock Text="Earnings Tracker  /  Design preview 01" Margin="16,0" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
            </DockPanel>
        </Border>
        <Grid x:Name="Shell" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource SidebarBackgroundColor}" BorderBrush="{StaticResource DefaultBorderColor}" BorderThickness="0,0,1,0">
                <Grid Margin="12,24,12,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="8,0,0,28">
                        <Border Width="32" Height="36" Background="{StaticResource AccentBackgroundColor}" CornerRadius="6" Margin="0,0,10,0">
                            <Path Data="M 0,20 L 0,0 16,0 M 0,9 L 12,9 M 0,20 L 16,20" Stroke="{StaticResource AccentColor}" StrokeThickness="3" Stretch="Uniform" Width="16" Height="20"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="EARNINGS" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="TRACKER" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="WORKSPACE" Style="{StaticResource Caption}" Margin="12,0,0,10"/>
                    <ListBox x:Name="Navigation" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="Navigation_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBoxItem Content="Dashboard" Tag="{x:Static enums:NavigationPage.Dashboard}" Style="{StaticResource NavButton}" IsSelected="True"/>
                        <ListBoxItem Content="Sessions" Tag="{x:Static enums:NavigationPage.Sessions}" Style="{StaticResource NavButton}"/>
                        <ListBoxItem Content="Games" Tag="{x:Static enums:NavigationPage.Games}" Style="{StaticResource NavButton}"/>
                        <ListBoxItem Content="Payments" Tag="{x:Static enums:NavigationPage.Payments}" Style="{StaticResource NavButton}"/>
                        <ListBoxItem Content="Statistics" Tag="{x:Static enums:NavigationPage.Statistics}" Style="{StaticResource NavButton}"/>
                        <ListBoxItem Content="Settings" Tag="{x:Static enums:NavigationPage.Settings}" Style="{StaticResource NavButton}"/>
                    </ListBox>
                    <Border Grid.Row="3" Style="{StaticResource SurfacePanel}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="SYNTHETIC DATA" Foreground="{StaticResource AccentTextColor}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Design preview only.&#10;No account connected." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                            <TextBlock Text="PRO-19 · UI prototypes" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="20" x:Name="PageRegion" SizeChanged="PageRegion_SizeChanged">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource TabName}"/>
                        <TextBlock Text="{Binding PageDescription}" Style="{StaticResource ItemSubtitle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsDashboard, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="Example" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="StateSelector" Width="126" ItemsSource="{Binding States}" SelectedItem="{Binding State}" AutomationProperties.Name="Dashboard example state"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Import sessions" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                            Command="{Binding ViewModel.ImportCommand, ElementName=SessionsExplorer}" Visibility="{Binding IsSessions, Converter={StaticResource VisibleIf}}"/>
                    <Button Grid.Column="1" Content="Starting view…" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                            Command="{Binding ViewModel.PreferencesCommand, ElementName=GamesLibrary}" Visibility="{Binding IsGames, Converter={StaticResource VisibleIf}}"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,12" Visibility="{Binding IsDashboard, Converter={StaticResource VisibleIf}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding RangeLabel}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="USD · recording date unless noted" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource SurfaceColor}" BorderBrush="{StaticResource DefaultBorderColor}" BorderThickness="1" CornerRadius="8" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Period7" Content="7 days" GroupName="Period" Tag="0" Style="{StaticResource PeriodButton}" Checked="Period_Checked"/>
                            <RadioButton x:Name="Period30" Content="30 days" GroupName="Period" Tag="1" IsChecked="True" Style="{StaticResource PeriodButton}" Checked="Period_Checked"/>
                            <RadioButton x:Name="Period90" Content="90 days" GroupName="Period" Tag="2" Style="{StaticResource PeriodButton}" Checked="Period_Checked"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <ScrollViewer x:Name="DashboardScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding ShowDashboard, Converter={StaticResource VisibleIf}}">
                    <!-- This is a finite summary, not the Sessions explorer. The five-row activity list has its own bound. -->
                    <StackPanel Margin="0,0,2,0">
                        <Border Style="{StaticResource FeedbackPanel}" Visibility="{Binding IsStale, Converter={StaticResource VisibleIf}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Retry" Style="{StaticResource SecondaryButton}" Command="{Binding RetryCommand}" Margin="12,0,0,0"/>
                                <TextBlock Text="Refresh failed · showing the previous synthetic snapshot from Oct 19, 23:59." Foreground="{StaticResource PendingTextColor}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                            </DockPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Metrics}" Margin="-4,0,-4,12">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid x:Name="MetricGrid" Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Panel}" Margin="4,0,4,8" MinHeight="110" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource DashboardStatLabel}" FontSize="12"/>
                                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,4,0,4" Height="36">
                                                <TextBlock Text="{Binding Value}" Style="{StaticResource DashboardStatValue}" Foreground="{Binding ValueBrush}" FontSize="28"/>
                                            </Viewbox>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid x:Name="AnalysisGrid" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border x:Name="TrendPanel" Style="{StaticResource Panel}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,12">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentColor}" Margin="0,0,6,0"/>
                                            <TextBlock Text="Verified" Style="{StaticResource Caption}" Margin="0,0,12,0"/>
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource PendingTextColor}" Margin="0,0,6,0"/>
                                            <TextBlock Text="Pending" Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Earnings over time" Style="{StaticResource SectionHeading}"/>
                                            <TextBlock Text="Session earnings · daily USD" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <local:EarningsChart x:Name="TrendChart" Grid.Row="1" Height="160" Days="{Binding Trend}" FontFamily="{StaticResource AppFont}"/>
                                    <TextBlock Grid.Row="2" Text="Verified sessions only; pending is shown separately. No adjustments in this fixture." Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                                    <Expander x:Name="DailyValues" Grid.Row="3" Header="Daily values" Style="{StaticResource ValuesExpander}" Margin="0,8,0,0" FontSize="12">
                                        <ListBox ItemsSource="{Binding Trend}" Height="140" Background="{StaticResource SurfaceColor}" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                 AutomationProperties.Name="Daily synthetic earnings values">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding Date, StringFormat={}{0:MMM d}}"/><Run Text=" · Verified "/>
                                                        <Run Text="{Binding Verified, StringFormat={}{0:C2}, ConverterCulture=en-US}"/><Run Text=" · Pending "/>
                                                        <Run Text="{Binding Pending, StringFormat={}{0:C2}, ConverterCulture=en-US}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>
                                </Grid>
                            </Border>
                            <Border x:Name="DistributionPanel" Grid.Column="2" Style="{StaticResource Panel}">
                                <StackPanel>
                                    <TextBlock Text="Session mix" Style="{StaticResource SectionHeading}"/>
                                    <TextBlock Text="{Binding SessionCount}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,8">
                                        <TextBlock Text="{Binding VerifiedShare}" FontSize="38" FontWeight="SemiBold"/>
                                        <TextBlock Text="verified" Style="{StaticResource Caption}" Margin="8,0,0,8" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding VerifiedPercent, Mode=OneWay}" Foreground="{StaticResource VerifiedTextColor}" Background="{StaticResource PendingTextColor}" BorderThickness="0" AutomationProperties.Name="Percentage of sessions verified"/>
                                    <Grid Margin="0,20,0,12">
                                        <TextBlock Text="{Binding VerifiedCountLabel}" Foreground="{StaticResource VerifiedTextColor}"/>
                                        <TextBlock Text="{Binding VerifiedAmount}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="{Binding PendingCountLabel}" Foreground="{StaticResource PendingTextColor}"/>
                                        <TextBlock Text="{Binding PendingAmount}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>
                                    <TextBlock Text="Distribution by session count. Amounts show earnings for each status." Style="{StaticResource Caption}" Margin="0,16,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid x:Name="ActivityGrid">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border x:Name="ActivityPanel" Style="{StaticResource Panel}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Sessions →" Style="{StaticResource GameLink}" Command="{Binding SessionsCommand}"/>
                                        <StackPanel>
                                            <TextBlock Text="Recent activity" Style="{StaticResource SectionHeading}"/>
                                            <TextBlock Text="{Binding RecentCaption}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid Grid.Row="1" Margin="0,14,0,4">
                                        <TextBlock Text="GAME / RECORDED" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="STATUS / EARNINGS" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ListBox x:Name="RecentList" Grid.Row="2" ItemsSource="{Binding RecentSessions}" Height="240" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Recent synthetic sessions">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Row" Background="Transparent"><ContentPresenter/></Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource ControlHoverColor}"/></Trigger>
                                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource AccentBackgroundColor}"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate></Setter.Value></Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource DefaultBorderColor}" BorderThickness="0,1,0,0" Padding="0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,12,0">
                                                            <Button Content="{Binding Game}" Command="{Binding DataContext.GameCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Game}" Style="{StaticResource GameLink}" Padding="0"/>
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Style="{StaticResource TransactionBadge}" Background="{Binding StatusBackground}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" Style="{StaticResource TransactionBadgeText}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding Amount}" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                            <Border x:Name="GamesPanel" Grid.Column="2" Style="{StaticResource Panel}">
                                <StackPanel>
                                    <TextBlock Text="Top earning games" Style="{StaticResource SectionHeading}"/>
                                    <TextBlock Text="Verified session earnings · USD" Style="{StaticResource Caption}" Margin="0,4,0,12"/>
                                    <ItemsControl ItemsSource="{Binding Games}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Background="{StaticResource ControlBackgroundColor}" CornerRadius="4" Width="48" Height="42" VerticalAlignment="Top" ClipToBounds="True">
                                                        <ContentControl Content="{Binding Cover}" Style="{StaticResource ArtworkPresenter}"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Amount}" FontWeight="SemiBold" Margin="8,3,0,0"/>
                                                            <Button Content="{Binding Name}" Command="{Binding DataContext.GameCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}" Style="{StaticResource GameLink}" Padding="0,2" FontSize="12"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,3,0,5"/>
                                                        <ProgressBar Value="{Binding Share, Mode=OneWay}" Style="{StaticResource MetricProgressBar}" Height="4" AutomationProperties.Name="Earnings relative to the top game"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Bars compare against the top game. Covers are illustrative; one is missing." Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="SYNTHETIC FIXTURE · As of Oct 19, 2026, 23:59 · Balance is an illustrative posted-date snapshot, independent of the selected period." Style="{StaticResource Caption}" Margin="0,12,0,4"/>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Style="{StaticResource Panel}" Visibility="{Binding ShowState, Converter={StaticResource VisibleIf}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                        <TextBlock Text="{Binding StateTitle}" Style="{StaticResource SectionHeading}" TextAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="{Binding StateMessage}" Style="{StaticResource EmptyStateText}"/>
                        <Button Content="Retry sample snapshot" Command="{Binding RetryCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Visibility="{Binding CanRetry, Converter={StaticResource VisibleIf}}"/>
                        <TextBlock Text="Synthetic example · no live services" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
                <sessions:SessionExplorerView x:Name="SessionsExplorer" Grid.Row="2" Visibility="{Binding DataContext.IsSessions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIf}}"/>
                <games:GameLibraryView x:Name="GamesLibrary" Grid.Row="2" Visibility="{Binding DataContext.IsGames, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIf}}"/>
                <Border x:Name="NavigationPlaceholder" Grid.Row="2" Style="{StaticResource Panel}" Visibility="{Binding ShowPlaceholder, Converter={StaticResource VisibleIf}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="450">
                        <TextBlock Text="{Binding PlaceholderText}" Style="{StaticResource EmptyStateText}"/>
                        <Button Content="← Back to Dashboard" Style="{StaticResource SecondaryButton}" Command="{Binding DashboardCommand}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Grid x:Name="GamePreview" Grid.RowSpan="2" Background="#B0000000" Visibility="{Binding IsPreviewOpen, Converter={StaticResource VisibleIf}}" KeyboardNavigation.TabNavigation="Cycle">
            <Border Style="{StaticResource Panel}" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="GAME PREVIEW · SYNTHETIC" Foreground="{StaticResource AccentTextColor}" FontSize="12" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding PreviewTitle}" Style="{StaticResource SectionHeading}"/>
                    <TextBlock Text="{Binding PreviewDescription}" Style="{StaticResource Caption}" Margin="0,12,0,20"/>
                    <Button x:Name="ClosePreviewButton" Content="{Binding PreviewReturnLabel}" Command="{Binding ClosePreviewCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
